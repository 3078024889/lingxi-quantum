    "audio-transcription": "persistent-draft",
    "batch-image-watermark-remover": "persistent-draft",
    "batch-pdf": "retain-tab",
    "burn-after-read-file": "server-job",
    "cross-page-stamp": "persistent-draft",
    "e-sign-pdf": "persistent-draft",
    "food-calorie": "retain-tab",
    "handwriting-ocr": "retain-tab",
    "id-photo-ai": "persistent-draft",
    "image-translator": "persistent-draft",
    "image-watermark-remover": "persistent-draft",
    "pdf-editor": "persistent-draft",
    "pdf-ocr": "retain-tab",
    "pdf-redact": "retain-tab",
    "pdf-to-word": "retain-tab",
    "sasi-deep-reason": "server-job",
    "sasi-image-generate": "server-job",
    "sasi-video-generate": "server-job",
    "subtitle-translate": "persistent-draft",
    "temp-mail-batch": "server-job",
    "video-dubbing": "persistent-draft",
    "video-transcription": "persistent-draft",
    "video-translate": "persistent-draft",
    "video-watermark-remover": "persistent-draft"
  }
}
