[Unit]
Description=LINGXIFIELD CN independent staging (3189 only)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=lingxifield
Group=lingxifield
WorkingDirectory=/opt/lingxifield/releases/cn-pr199
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3189
Environment="NODE_OPTIONS=--max-old-space-size=512 --dns-result-order=ipv4first"
EnvironmentFile=/etc/lingxifield/staging.env
ExecStart=/opt/lingxifield/runtime/node-24.19.0/bin/node /opt/lingxifield/releases/cn-pr199/server.js
MemoryMax=750M
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
