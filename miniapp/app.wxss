page { background: #101936; color: #eef1ff; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
.lx-page { min-height: 100vh; position: relative; overflow: hidden; background: radial-gradient(circle at 16% 8%, rgba(114,86,171,.38), transparent 36%), radial-gradient(circle at 88% 18%, rgba(46,156,172,.28), transparent 40%), linear-gradient(160deg,#211e4b 0%,#10274a 48%,#08152f 100%); }
.lx-orbit { position: absolute; width: 640rpx; height: 640rpx; border: 1rpx solid rgba(221,218,255,.14); border-radius: 50%; top: 170rpx; left: -280rpx; box-shadow: 0 0 100rpx rgba(112,211,207,.09); }
.lx-content { position: relative; z-index: 1; padding: 0 30rpx 48rpx; }
.lx-nav { position: relative; z-index: 4; padding: calc(env(safe-area-inset-top) + 26rpx) 30rpx 22rpx; display: flex; align-items: center; justify-content: space-between; }
.lx-brand { font-family: Georgia, serif; font-size: 28rpx; letter-spacing: 10rpx; color: #f3e8ca; }
.lx-kicker { font-family: Georgia, serif; color: #7adfd4; letter-spacing: 6rpx; font-size: 20rpx; text-transform: uppercase; }
.lx-title { font-size: 50rpx; line-height: 1.28; font-weight: 500; letter-spacing: 3rpx; margin: 22rpx 0; }
.lx-subtitle { color: rgba(233,237,255,.72); font-size: 28rpx; line-height: 1.8; }
.lx-veil { background: linear-gradient(135deg,rgba(244,244,255,.13),rgba(223,242,244,.07)); border: 1rpx solid rgba(255,255,255,.19); border-radius: 8rpx; box-shadow: 0 24rpx 80rpx rgba(2,7,28,.16); }
.lx-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 18rpx; }
.lx-card { padding: 28rpx 24rpx; min-height: 186rpx; }
.lx-card-title { font-size: 30rpx; font-weight: 500; margin: 12rpx 0; }
.lx-card-note { font-size: 23rpx; color: rgba(235,239,255,.64); line-height: 1.65; }
.lx-price { margin-top: 20rpx; color: #eacb8e; font-family: Georgia, serif; font-size: 27rpx; }
.lx-button { margin-top: 28rpx; border: 1rpx solid rgba(119,227,214,.58); border-radius: 4rpx; color: #dffcf7; background: rgba(62,165,163,.16); font-size: 27rpx; letter-spacing: 4rpx; line-height: 90rpx; }
.lx-button::after { border: 0; }
.lx-section { margin-top: 52rpx; }
.lx-section-title { font-size: 34rpx; font-weight: 500; letter-spacing: 3rpx; margin-bottom: 24rpx; }
.lx-empty { padding: 80rpx 32rpx; text-align: center; color: rgba(235,239,255,.58); line-height: 1.8; }
.lx-loading { padding: 100rpx 0; text-align: center; color: #77d7cf; letter-spacing: 4rpx; }

