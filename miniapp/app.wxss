@import "./share.wxss";

page {
  --lx-bg: #f4f3ef;
  --lx-bg-elevated: rgba(255, 255, 252, .72);
  --lx-bg-soft: #ebe9e2;
  --lx-text: #171714;
  --lx-text-soft: #66635b;
  --lx-text-muted: #908c82;
  --lx-line: rgba(32, 31, 27, .11);
  --lx-line-strong: rgba(32, 31, 27, .18);
  --lx-button: #171714;
  --lx-button-text: #ffffff;
  --lx-success: #4e765e;
  --lx-shadow: 0 18rpx 70rpx rgba(22, 21, 18, .05);

  background: var(--lx-bg);
  color: var(--lx-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

@media (prefers-color-scheme: dark) {
  page {
    --lx-bg: #11110f;
    --lx-bg-elevated: rgba(28, 28, 25, .78);
    --lx-bg-soft: #1d1d19;
    --lx-text: #f2f0e9;
    --lx-text-soft: #b9b5aa;
    --lx-text-muted: #8f8b81;
    --lx-line: rgba(255, 255, 255, .10);
    --lx-line-strong: rgba(255, 255, 255, .17);
    --lx-button: #f3f1ea;
    --lx-button-text: #151512;
    --lx-success: #7fba91;
    --lx-shadow: 0 22rpx 80rpx rgba(0, 0, 0, .20);
  }
}

button {
  font: inherit;
}

button::after {
  border: 0;
}

.lx-page {
  min-height: 100vh;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 88% -4%, rgba(177, 164, 124, .12), transparent 31%),
    var(--lx-bg);
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.lx-shell {
  width: 100%;
  max-width: 980rpx;
  margin: 0 auto;
  padding: calc(34rpx + env(safe-area-inset-top)) 36rpx 48rpx;
  box-sizing: border-box;
}

.lx-brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 66rpx;
  margin-bottom: 64rpx;
}

.lx-brand-name {
  font-size: 27rpx;
  line-height: 1;
  font-weight: 680;
  letter-spacing: .12em;
}

.lx-brand-en {
  font-size: 18rpx;
  line-height: 1;
  color: var(--lx-text-muted);
  letter-spacing: .16em;
}

.lx-kicker {
  margin-bottom: 18rpx;
  font-size: 18rpx;
  line-height: 1.35;
  color: var(--lx-text-muted);
  font-weight: 650;
  letter-spacing: .17em;
  text-transform: uppercase;
}

.lx-title {
  max-width: 680rpx;
  font-size: 48rpx;
  line-height: 1.22;
  font-weight: 670;
  letter-spacing: -.038em;
  text-wrap: balance;
}

.lx-subtitle {
  max-width: 700rpx;
  margin-top: 22rpx;
  font-size: 26rpx;
  line-height: 1.78;
  color: var(--lx-text-soft);
  letter-spacing: .005em;
}

.lx-section {
  margin-top: 58rpx;
}

.lx-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 28rpx;
  margin-bottom: 20rpx;
}

.lx-section-title {
  font-size: 29rpx;
  line-height: 1.4;
  font-weight: 640;
}

.lx-section-note {
  max-width: 280rpx;
  font-size: 21rpx;
  line-height: 1.55;
  color: var(--lx-text-muted);
  text-align: right;
}

.lx-list {
  border-top: 1rpx solid var(--lx-line);
}

.lx-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  min-height: 128rpx;
  padding: 26rpx 2rpx;
  border-bottom: 1rpx solid var(--lx-line);
  box-sizing: border-box;
}

.lx-row:active {
  opacity: .72;
}

.lx-row-main {
  flex: 1;
  min-width: 0;
}

.lx-row-title {
  font-size: 28rpx;
  line-height: 1.42;
  font-weight: 625;
  letter-spacing: -.01em;
}

.lx-row-note {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.66;
  color: var(--lx-text-soft);
}

.lx-arrow {
  flex: 0 0 auto;
  font-size: 30rpx;
  line-height: 1;
  color: var(--lx-text-muted);
  transform: translateY(-1rpx);
}

.lx-feature {
  margin-top: 34rpx;
  padding: 34rpx;
  border: 1rpx solid var(--lx-line-strong);
  border-radius: 26rpx;
  background: var(--lx-bg-elevated);
  box-shadow: var(--lx-shadow);
  backdrop-filter: blur(18px);
  box-sizing: border-box;
}

.lx-feature-title {
  font-size: 33rpx;
  line-height: 1.42;
  font-weight: 645;
  letter-spacing: -.015em;
}

.lx-feature-note {
  margin-top: 13rpx;
  font-size: 24rpx;
  line-height: 1.74;
  color: var(--lx-text-soft);
}

.lx-button {
  width: 100%;
  height: 88rpx;
  margin: 28rpx 0 0;
  padding: 0 28rpx;
  border-radius: 18rpx;
  background: var(--lx-button);
  color: var(--lx-button-text);
  font-size: 25rpx;
  line-height: 88rpx;
  font-weight: 620;
  text-align: center;
  box-sizing: border-box;
}

.lx-button:active {
  opacity: .82;
}

.lx-button.secondary {
  background: var(--lx-bg-soft);
  color: var(--lx-text);
  border: 1rpx solid var(--lx-line);
}

.lx-status {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 0 4rpx;
  font-size: 23rpx;
  color: var(--lx-text-soft);
}

.lx-status-dot {
  width: 13rpx;
  height: 13rpx;
  border-radius: 999rpx;
  background: var(--lx-text-muted);
}

.lx-status-dot.ready {
  background: var(--lx-success);
}

.lx-support {
  margin-top: 42rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--lx-line);
  font-size: 21rpx;
  line-height: 1.75;
  color: var(--lx-text-muted);
}

@media (min-width: 760px) {
  .lx-shell {
    padding-left: 48rpx;
    padding-right: 48rpx;
  }

  .lx-title {
    font-size: 52rpx;
  }

  .lx-row {
    min-height: 136rpx;
  }
}
