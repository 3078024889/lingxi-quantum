.field-9d-trigger{position:fixed;right:24rpx;bottom:150rpx;z-index:80;display:flex;width:106rpx;height:106rpx;flex-direction:column;align-items:center;justify-content:center;border:1rpx solid rgba(138,230,221,.72);border-radius:50%;background:radial-gradient(circle at 34% 26%,rgba(205,249,255,.42),rgba(90,80,181,.72) 45%,rgba(7,19,52,.98) 78%);box-shadow:0 0 0 10rpx rgba(121,221,215,.05),0 0 42rpx rgba(100,195,225,.38);color:#fff;line-height:1}.field-9d-trigger::after{border:0}.field-9d-mark{font-family:Georgia,serif;font-size:36rpx;letter-spacing:2rpx}.field-9d-label{margin-top:7rpx;color:#9ce8df;font-size:16rpx;letter-spacing:2rpx}.field-9d-mask{position:fixed;inset:0;z-index:90;display:flex;align-items:flex-end;background:rgba(2,5,22,.62)}.field-9d-sheet{width:100%;overflow:hidden;border-top:1rpx solid rgba(166,222,255,.46);border-radius:26rpx 26rpx 0 0;background:linear-gradient(145deg,rgba(13,19,55,.98),rgba(29,41,94,.98));box-shadow:0 -24rpx 90rpx rgba(0,4,28,.5);padding-bottom:env(safe-area-inset-bottom)}.field-9d-head{padding:30rpx 32rpx 24rpx}.field-9d-kicker{color:#86e4dc;font-family:Georgia,serif;font-size:18rpx;letter-spacing:6rpx}.field-9d-title{margin-top:10rpx;color:#f5f1ff;font-family:Georgia,"Noto Serif SC",serif;font-size:34rpx;letter-spacing:2rpx}.field-9d-note{margin-top:10rpx;color:rgba(229,235,255,.66);font-size:22rpx;letter-spacing:2rpx}.field-9d-video{display:block;width:100%;height:422rpx;background:#050b25}.field-9d-actions{display:flex;justify-content:flex-end;gap:16rpx;padding:20rpx 26rpx 24rpx}.field-9d-actions button{margin:0;border:1rpx solid rgba(130,219,219,.46);border-radius:4rpx;background:rgba(84,120,174,.16);color:#dffbf8;font-size:22rpx;line-height:66rpx;letter-spacing:3rpx;padding:0 28rpx}.field-9d-actions button::after{border:0}
.field-9d-trigger{right:auto;bottom:auto;touch-action:none}.field-9d-fallback{background:#050b25}
