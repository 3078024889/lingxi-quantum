<view class="lx-page"><field-nav show-back="{{true}}" title="保存 PDF"/><view class="lx-content pdf-save"><view class="panel lx-veil"><view wx:if="{{status}}" class="status">{{status}}</view><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{error}}" class="lx-button" bindtap="retry">重新下载</button><button wx:if="{{tempFilePath}}" class="lx-button secondary" bindtap="openAgain">再次打开 PDF</button><view class="note">文件打开后，点击右上角“…”即可发送给朋友、收藏或保存到微信可用的位置。</view></view></view></view>
