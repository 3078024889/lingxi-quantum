.product-nav { position: relative; z-index: 4; padding: calc(env(safe-area-inset-top) + 18rpx) 30rpx 18rpx; display: flex; align-items: center; justify-content: space-between; }
.back { min-width: 140rpx; min-height: 64rpx; display: flex; align-items: center; gap: 10rpx; color: rgba(241,244,255,.88); font-size: 26rpx; }
.back-arrow { font-size: 52rpx; line-height: 1; font-family: Arial, sans-serif; font-weight: 300; }
.nav-brand { color: #f3e8ca; font-family: Georgia, serif; font-size: 25rpx; letter-spacing: 7rpx; }
.nav-spacer { width: 140rpx; }
.detail-state { margin-top: 60rpx; }
.detail { margin-top: 30rpx; padding: 52rpx 40rpx; }
.promise { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 50rpx; color: rgba(233,239,255,.74); font-size: 25rpx; }
.promise view { border-left: 1rpx solid rgba(114,220,208,.6); padding: 10rpx 16rpx; }
.narrative-promise { margin-top: 44rpx; padding-left: 18rpx; border-left: 1rpx solid rgba(114,220,208,.6); color: rgba(233,239,255,.7); font-size: 25rpx; line-height: 1.8; }
.price { margin-top: 54rpx; font-size: 42rpx; }
.fineprint { margin-top: 24rpx; font-size: 21rpx; line-height: 1.7; color: rgba(235,239,255,.45); }
.compact { width: 280rpx; margin-left: auto; margin-right: auto; }
.owned-note{margin:28rpx 0 18rpx;color:#76ded2;font-size:25rpx;letter-spacing:2rpx}
.detail-description{margin-top:32rpx;color:rgba(242,245,255,.9);font-family:Georgia,"Noto Serif SC",serif;font-size:27rpx;line-height:1.8}.detail-benefits{margin-top:26rpx}.detail-benefit{margin-top:12rpx;padding:14rpx 0 14rpx 20rpx;border-left:2rpx solid rgba(118,222,210,.48)}.detail-benefit-title{color:rgba(244,246,255,.92);font-size:25rpx}.detail-benefit-note{margin-top:7rpx;color:rgba(224,231,248,.62);font-size:22rpx;line-height:1.65}.detail-closing{margin-top:28rpx;color:#a7eee8;font-size:23rpx;line-height:1.75}
.purchase-disclosure { margin: 34rpx 0 24rpx; padding: 24rpx 26rpx; border: 1rpx solid rgba(118,222,210,.25); background: rgba(8,27,60,.3); }
.disclosure-row { display: flex; align-items: flex-start; gap: 24rpx; padding: 11rpx 0; }
.disclosure-label { flex: 0 0 112rpx; color: #8fe9df; font-size: 21rpx; letter-spacing: 2rpx; }
.disclosure-value { flex: 1; color: rgba(235,241,255,.72); font-size: 22rpx; line-height: 1.65; }
.agreement { margin: 0 0 28rpx; padding: 0 4rpx; }
.agreement-check { display: flex; align-items: center; color: rgba(235,241,255,.72); font-size: 22rpx; }
.agreement-check checkbox { transform: scale(.78); transform-origin: left center; }
.agreement-links { margin-top: 10rpx; padding-left: 44rpx; line-height: 1.8; }
.policy-link { margin-right: 8rpx; color: #8fe9df; font-size: 21rpx; }
.stellar-risk{margin-bottom:26rpx;padding:24rpx;border:1rpx solid rgba(230,201,135,.32);background:rgba(230,201,135,.055)}.stellar-risk-title{color:#e6c987;font-size:21rpx;letter-spacing:4rpx}.stellar-risk-copy{margin-top:14rpx;color:rgba(240,242,255,.78);font-size:22rpx;line-height:1.8}.stellar-risk-note{margin:12rpx 0 18rpx;color:rgba(232,235,248,.5);font-size:20rpx;line-height:1.7}.stellar-risk-check{align-items:flex-start;color:rgba(242,230,197,.82)}
.support-button { margin-top: 18rpx; padding: 10rpx 0; border: 0; background: transparent; color: rgba(143,233,223,.76); font-size: 21rpx; line-height: 1.5; }
.support-button::after { border: 0; }
.stellar-intake{margin-top:48rpx;padding:30rpx 24rpx;border:1rpx solid rgba(118,222,210,.25);background:rgba(7,22,55,.34)}
.stellar-intake-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20rpx}.stellar-step{color:#e6c987;font-size:20rpx;letter-spacing:4rpx}.stellar-intake-title{margin-top:8rpx;color:#f1edff;font-family:Georgia,"Noto Serif SC",serif;font-size:34rpx}.stellar-completeness{color:#8fe9df;font-family:Georgia,serif;font-size:28rpx}.stellar-progress{height:3rpx;margin-top:18rpx;background:rgba(255,255,255,.1);overflow:hidden}.stellar-progress view{height:100%;background:linear-gradient(90deg,#76ded2,#e6c987);transition:width .25s ease}.stellar-intro{margin:22rpx 0 28rpx;color:rgba(229,235,250,.67);font-size:22rpx;line-height:1.8}
.stellar-field{margin-top:22rpx}.stellar-label{color:rgba(236,241,255,.76);font-size:22rpx;letter-spacing:1rpx}.stellar-field input,.stellar-field textarea,.stellar-picker{box-sizing:border-box;width:100%;margin-top:10rpx;padding:21rpx 20rpx;border:1rpx solid rgba(143,233,223,.22);background:rgba(2,13,38,.46);color:#f1f3ff;font-size:25rpx;line-height:1.5}.stellar-field textarea{min-height:124rpx}.stellar-field input::placeholder,.stellar-field textarea::placeholder{color:rgba(225,231,246,.28)}.stellar-coordinate{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.stellar-divider{height:1rpx;margin:38rpx 0 30rpx;background:rgba(255,255,255,.1)}.stellar-ready{margin-top:28rpx;padding:20rpx;border-left:2rpx solid rgba(230,201,135,.55);background:rgba(230,201,135,.05);color:rgba(235,239,255,.58);font-size:21rpx;line-height:1.7}.stellar-ready.ready{border-left-color:#76ded2;color:#a7eee8;background:rgba(118,222,210,.06)}
.stellar-field input,.stellar-field textarea{color:#f1f3ff!important;-webkit-text-fill-color:#f1f3ff!important;caret-color:#8fe9df!important;opacity:1!important;font-weight:500}.stellar-field input[disabled],.stellar-field textarea[disabled]{color:#f1f3ff!important;-webkit-text-fill-color:#f1f3ff!important}.stellar-picker.is-placeholder{color:rgba(225,231,246,.34)}.stellar-progress-caption{margin-top:12rpx;color:rgba(220,229,248,.54);font-size:19rpx}.stellar-map-button{box-sizing:border-box;width:100%;margin-top:10rpx;padding:20rpx;border:1rpx solid rgba(230,201,135,.48);border-radius:0;background:rgba(230,201,135,.08);color:#f2d996;font-size:24rpx;line-height:1.5}.stellar-map-button::after{border:0}.stellar-location-result{margin-top:12rpx;padding:18rpx;border-left:2rpx solid #76ded2;background:rgba(118,222,210,.06);color:#eef4ff;font-size:23rpx;line-height:1.65}.stellar-location-result text{display:block;margin-top:6rpx;color:rgba(143,233,223,.72);font-size:19rpx}.stellar-help{margin-top:12rpx;color:rgba(224,231,248,.54);font-size:20rpx;line-height:1.7}
