.product-nav { position: relative; z-index: 4; padding: calc(env(safe-area-inset-top) + 18rpx) 30rpx 18rpx; display: flex; align-items: center; justify-content: space-between; }
.back { min-width: 140rpx; min-height: 64rpx; display: flex; align-items: center; gap: 10rpx; color: rgba(241,244,255,.88); font-size: 26rpx; }
.back-arrow { font-size: 52rpx; line-height: 1; font-family: Arial, sans-serif; font-weight: 300; }
.nav-brand { color: #f3e8ca; font-family: Georgia, serif; font-size: 25rpx; letter-spacing: 7rpx; }
.nav-spacer { width: 140rpx; }
.detail-state { margin-top: 60rpx; }
.detail { margin-top: 30rpx; padding: 52rpx 40rpx; }
.promise { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 50rpx; color: rgba(233,239,255,.74); font-size: 25rpx; }
.promise view { border-left: 1rpx solid rgba(114,220,208,.6); padding: 10rpx 16rpx; }
.narrative-promise { margin-top: 44rpx; padding-left: 18rpx; border-left: 1rpx solid rgba(114,220,208,.6); color: rgba(233,239,255,.7); font-size: 25rpx; line-height: 1.8; }
.price { margin-top: 54rpx; font-size: 42rpx; }
.fineprint { margin-top: 24rpx; font-size: 21rpx; line-height: 1.7; color: rgba(235,239,255,.45); }
.compact { width: 280rpx; margin-left: auto; margin-right: auto; }
