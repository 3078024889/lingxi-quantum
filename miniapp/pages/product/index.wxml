<view class="lx-page">
  <view class="lx-orbit"></view>
  <view class="product-nav">
    <view class="back" bindtap="back"><text class="back-arrow">‹</text><text>返回</text></view>
    <view class="nav-brand">灵犀场</view>
    <view class="nav-spacer"></view>
  </view>
  <view wx:if="{{loading}}" class="lx-loading detail-state">正在展开内容…</view>
  <view wx:elif="{{loadError}}" class="lx-content detail-state">
    <view class="lx-empty lx-veil"><view>{{loadError}}</view><button class="lx-button compact" bindtap="loadItem">重新连接</button></view>
  </view>
  <view wx:elif="{{item}}" class="lx-content">
    <view class="detail lx-veil">
      <view class="lx-kicker">{{item.category === 'narrative' ? 'MULTIDIMENSIONAL NARRATIVE' : 'LINGXI ARCHIVE'}}</view>
      <view class="lx-title">{{item.name}}</view>
      <view class="lx-subtitle">{{item.note}}</view>
      <view class="promise" wx:if="{{item.category === 'report'}}"><view>结构识别</view><view>现实映射</view><view>反证条件</view><view>行动实验</view></view>
      <view class="narrative-promise" wx:if="{{item.category === 'narrative'}}">先不要急着寻找答案。<br/>静静感受：这段叙事，是否映照了你正在经历，却尚未完全表达的生命状态。</view>
      <view class="narrative-promise" wx:elif="{{item.category === 'practice'}}">不是观看一套课程，而是把一项可重复的修炼带回身体与日常。</view>
      <view class="narrative-promise" wx:elif="{{item.category === 'membership'}}">在有效期内进入对应场域；神尊全域解锁同时包含未来新增的报告、叙事、修炼技术与场域模块。</view>
      <view wx:if="{{owned}}" class="owned-note">已在你的场域中 ✓</view>
      <view wx:else class="lx-price price">¥ {{item.priceFen / 100}}</view>
      <button wx:if="{{owned}}" class="lx-button" disabled="{{opening}}" loading="{{opening}}" bindtap="openOwned">{{item.category === 'report' ? '打开完整生命档案' : item.category === 'narrative' ? '阅读全文' : item.category === 'practice' ? '进入修炼' : '进入已开启场域'}}</button>
      <button wx:else class="lx-button" disabled="{{paying}}" loading="{{paying}}" bindtap="pay">{{item.category === 'narrative' ? '进入完整叙事' : item.category === 'practice' ? '开启这项修炼' : item.category === 'membership' ? '开启场域权益' : '开启这份生命档案'}}</button>
      <view class="fineprint">{{owned ? '阅读权限会由服务端再次核验，确保内容只向已开启的账户开放。' : '虚拟内容将在支付确认后自动交付。最终权益以服务端支付通知为准。'}}</view>
    </view>
  </view>
</view>
