.lx-setting-card{margin-top:40rpx;border:1rpx solid var(--lx-line);border-radius:28rpx;background:var(--lx-bg-elevated);overflow:hidden;box-shadow:var(--lx-shadow)}.lx-setting-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;min-height:126rpx;padding:24rpx 28rpx;border-bottom:1rpx solid var(--lx-line)}.lx-setting-row:last-child{border-bottom:0}.lx-setting-row b{font-size:27rpx}.lx-setting-row small{display:block;max-width:430rpx;margin-top:8rpx;font-size:20rpx;line-height:1.5;color:var(--lx-text-muted)}.lx-setting-pill{min-width:118rpx;padding:16rpx 20rpx;border-radius:18rpx;background:var(--lx-bg-soft);font-size:23rpx;text-align:center}