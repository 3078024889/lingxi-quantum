.lx-home41{padding-top:calc(28rpx + env(safe-area-inset-top))}.lx-home-orbit{display:grid;place-items:center;width:64rpx;height:64rpx;border:1rpx solid var(--lx-line);border-radius:50%;font-size:28rpx}.lx-home-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:46rpx}.lx-home-card{position:relative;min-height:250rpx;padding:26rpx;border:1rpx solid var(--lx-line);border-radius:28rpx;background:var(--lx-bg-elevated);box-shadow:var(--lx-shadow);box-sizing:border-box}.lx-home-card.primary{grid-column:1/-1;min-height:230rpx}.lx-home-icon{display:grid;place-items:center;width:54rpx;height:54rpx;border-radius:18rpx;background:var(--lx-bg-soft);font-size:24rpx}.lx-home-card-title{margin-top:30rpx;font-size:30rpx;font-weight:660}.lx-home-card-note{margin-top:10rpx;font-size:22rpx;line-height:1.6;color:var(--lx-text-soft)}.lx-home-arrow{position:absolute;right:24rpx;bottom:22rpx;color:var(--lx-text-muted);font-size:28rpx}.lx-home-links{margin-top:30rpx;border-top:1rpx solid var(--lx-line)}.lx-home-link{display:grid;grid-template-columns:44rpx 1fr auto;align-items:center;gap:16rpx;min-height:116rpx;border-bottom:1rpx solid var(--lx-line)}.lx-home-link b{display:block;font-size:26rpx}.lx-home-link small{display:block;margin-top:6rpx;font-size:21rpx;line-height:1.45;color:var(--lx-text-muted)}