<view class="lx-page">
  <view class="lx-shell">
    <view class="lx-brand">
      <view class="lx-brand-name">灵犀场</view>
      <view class="lx-brand-en">TOOLS</view>
    </view>

    <view class="lx-kicker">PRACTICAL TOOLS</view>
    <view class="lx-title">需要处理什么，直接开始。</view>
    <view class="lx-subtitle">PDF、图片、视频、OCR、字幕、隐私与文件处理。优先在本地完成，确需服务器处理时再上传。</view>

    <view class="lx-section">
      <view class="lx-list">
        <view wx:for="{{tools}}" wx:key="path" class="lx-row" data-index="{{index}}" bindtap="open">
          <view class="lx-row-main">
            <view class="lx-row-title">{{item.title}}</view>
            <view class="lx-row-note">{{item.note}}</view>
          </view>
          <view class="lx-arrow">›</view>
        </view>
      </view>
    </view>

    <button class="lx-button" bindtap="allTools">查看全部工具</button>
  </view>
</view>
