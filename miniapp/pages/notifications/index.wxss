.lx-notify41{padding-top:calc(30rpx + env(safe-area-inset-top))}.lx-notify-list{margin-top:38rpx;border-top:1rpx solid var(--lx-line)}.lx-notify-card{display:grid;grid-template-columns:62rpx 1fr;gap:18rpx;padding:26rpx 2rpx;border-bottom:1rpx solid var(--lx-line)}.lx-notify-icon{display:grid;place-items:center;width:58rpx;height:58rpx;border-radius:20rpx;background:var(--lx-bg-soft);font-size:24rpx}.lx-notify-title{font-size:28rpx;font-weight:650}.lx-notify-body{margin-top:8rpx;font-size:23rpx;line-height:1.6;color:var(--lx-text-soft)}.lx-notify-time{margin-top:12rpx;font-size:20rpx;color:var(--lx-text-muted)}.lx-notify-empty{display:flex;min-height:360rpx;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;color:var(--lx-text-muted)}.lx-notify-mark{display:grid;place-items:center;width:82rpx;height:82rpx;border-radius:50%;background:var(--lx-bg-soft);font-size:30rpx}