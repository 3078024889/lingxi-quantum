.page{min-height:100vh;background:#f4f3ef;color:#171713;padding:24rpx}.shell{max-width:1100rpx;margin:0 auto}.title{font-size:48rpx;font-weight:700;margin:24rpx 0}.list{display:flex;flex-direction:column;gap:20rpx}.card{background:#fff;border:1rpx solid rgba(0,0,0,.08);border-radius:28rpx;padding:28rpx}.card-title{font-size:30rpx;font-weight:650}.card-body{font-size:27rpx;line-height:1.7;margin-top:10rpx;color:#555}.time{font-size:22rpx;color:#888;margin-top:14rpx}.empty{padding:80rpx 0;color:#777;text-align:center}
