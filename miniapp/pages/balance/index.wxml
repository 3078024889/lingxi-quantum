<view class="lx-page mini-topup-page">
  <view class="lx-shell mini-topup-shell">
    <view class="mini-topup-brand">
      <view>
        <view class="mini-topup-brand-name">灵犀场</view>
        <view class="mini-topup-brand-caption">LINGXIFIELD · WALLET</view>
      </view>
      <view class="mini-topup-brand-tag">CNY · WECHAT</view>
    </view>

    <view class="mini-topup-hero">
      <view class="mini-topup-kicker">BALANCE / TOP UP</view>
      <view class="mini-topup-title">{{hasRequestedAmount ? '确认充值' : '余额充值'}}</view>
      <view class="mini-topup-subtitle">人民币余额 · 微信小程序虚拟支付</view>
    </view>

    <view class="mini-topup-card mini-topup-account">
      <view class="mini-topup-account-top">
        <view class="mini-topup-account-copy">
          <view class="mini-topup-label">到账账户</view>
          <view class="mini-topup-account-name">{{accountLoaded ? (linked ? accountLabel : '尚未连接灵犀场账户') : '正在读取账户余额'}}</view>
        </view>
        <view wx:if="{{accountLoaded && linked}}" class="mini-topup-balance">
          <view>当前余额</view>
          <text>¥{{balanceText}}</text>
        </view>
      </view>
      <view wx:if="{{accountLoaded && linked}}" class="mini-topup-account-note">可退本金 ¥{{refundableText}} · 充值将计入当前连接账户</view>
      <view class="mini-topup-account-actions">
        <button class="mini-topup-light-button" bindtap="connectAccount" disabled="{{busy}}">{{linked ? '切换到账账户' : '登录并连接账户'}}</button>
        <button wx:if="{{!accountLoaded}}" class="mini-topup-light-button" bindtap="refreshAccount" disabled="{{busy}}">重新读取余额</button>
      </view>
    </view>

    <view class="mini-topup-card mini-topup-amount-card">
      <view class="mini-topup-section-head">
        <view>
          <view class="mini-topup-section-title">选择充值金额</view>
          <view class="mini-topup-section-note">{{hasRequestedAmount ? '已带入钱包页面所选金额，可在此调整。' : '充值完成后自动计入已连接的灵犀场账户。'}}</view>
        </view>
        <view class="mini-topup-currency">CNY</view>
      </view>

      <view class="topup-options">
        <button wx:for="{{amounts}}" wx:key="*this" data-amount="{{item}}" bindtap="choose" disabled="{{busy}}" class="topup-option {{selected == item ? 'selected' : ''}}">¥{{item}}</button>
        <button data-amount="custom" bindtap="choose" disabled="{{busy}}" class="topup-option {{selected == 'custom' ? 'selected' : ''}}">自定义</button>
      </view>

      <view wx:if="{{selected == 'custom'}}" class="mini-topup-custom">
        <view class="mini-topup-label">自定义金额</view>
        <view class="mini-topup-custom-row">
          <text>¥</text>
          <input type="digit" value="{{custom}}" bindinput="input" disabled="{{busy}}" placeholder="输入整数金额" maxlength="5"/>
        </view>
      </view>

      <view class="mini-topup-total">
        <view>
          <view class="mini-topup-label">本次充值</view>
          <view class="mini-topup-total-amount">¥{{selected == 'custom' ? custom : selected}}</view>
        </view>
        <view class="mini-topup-total-note">
          <view>单笔 1–10,000 元</view>
          <view>自定义金额仅支持整数元</view>
        </view>
      </view>

      <view wx:if="{{paymentNotice}}" class="mini-topup-notice">{{paymentNotice}}</view>
      <view class="mini-topup-status">{{message}}</view>

      <button wx:if="{{!enabled}}" class="lx-button secondary mini-topup-action" bindtap="refreshAvailability" loading="{{loading}}" disabled="{{loading}}">重新检查充值服务</button>
      <button wx:if="{{enabled || orderId}}" class="lx-button mini-topup-action" bindtap="pay" loading="{{busy}}" disabled="{{busy || (!orderId && !canPay)}}">{{orderId ? '检查上一笔充值结果' : '确认充值'}}</button>
      <button wx:if="{{orderId}}" class="lx-button secondary mini-topup-action" bindtap="startNew" disabled="{{busy}}">保留旧订单，开始新充值</button>
      <button wx:if="{{orderId}}" class="lx-button secondary mini-topup-action" bindtap="deletePending" disabled="{{busy}}">删除旧订单，重新充值</button>
    </view>

    <view class="mini-topup-quicklinks">
      <button bindtap="openAccount">查看账户</button>
      <button bindtap="openRefunds">退款方式与进度</button>
      <button bindtap="openOrders">查看已有订单</button>
    </view>

    <view class="mini-topup-history">
      <view class="mini-topup-section-title">最近充值与到账进度</view>
      <view wx:for="{{topups}}" wx:key="id" class="mini-topup-history-row">
        <view>¥{{item.amountText}}</view>
        <view>{{item.statusText}}</view>
      </view>
      <view wx:if="{{!topups.length}}" class="mini-topup-empty">暂无充值记录</view>
      <button class="lx-button secondary mini-topup-action" bindtap="refreshProgress" disabled="{{busy}}">刷新余额与充值进度</button>
    </view>
  </view>
</view>