.lx-row.is-selected{border-color:#11110f}.lx-row.is-selected .lx-row-title{font-weight:700}
.topup-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin:32rpx 0}
.topup-option{width:100%;min-width:0;margin:0;background:var(--lx-bg-elevated);border:1rpx solid var(--lx-line-strong);border-radius:20rpx;font-size:30rpx;box-sizing:border-box}
.topup-option.selected{border-color:#2872e3;background:#eef4ff;color:#1654af}
.topup-option[disabled]{opacity:.55}
