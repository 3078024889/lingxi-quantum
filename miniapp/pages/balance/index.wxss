.mini-topup-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 90% 0%, rgba(123, 102, 255, .13), transparent 34%),
    radial-gradient(circle at 0% 45%, rgba(93, 164, 255, .08), transparent 30%),
    #f5f6fc;
  color: #202747;
}
.mini-topup-shell {
  max-width: 980rpx;
  padding-top: calc(28rpx + env(safe-area-inset-top));
  padding-bottom: calc(54rpx + env(safe-area-inset-bottom));
}
.mini-topup-brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 42rpx;
}
.mini-topup-brand-name {
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 760;
  letter-spacing: .08em;
}
.mini-topup-brand-caption {
  margin-top: 7rpx;
  color: #8791ae;
  font-size: 17rpx;
  letter-spacing: .18em;
}
.mini-topup-brand-tag {
  padding: 12rpx 18rpx;
  border: 1rpx solid rgba(117, 103, 226, .22);
  border-radius: 999rpx;
  background: rgba(255,255,255,.72);
  color: #6458c8;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: .08em;
}
.mini-topup-hero { margin-bottom: 26rpx; }
.mini-topup-kicker {
  color: #8175df;
  font-size: 18rpx;
  font-weight: 750;
  letter-spacing: .18em;
}
.mini-topup-title {
  margin-top: 12rpx;
  color: #202747;
  font-size: 48rpx;
  line-height: 1.2;
  font-weight: 760;
  letter-spacing: -.035em;
}
.mini-topup-subtitle {
  margin-top: 12rpx;
  color: #7b86a6;
  font-size: 24rpx;
  line-height: 1.6;
}
.mini-topup-card {
  margin-top: 22rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(121, 112, 220, .20);
  border-radius: 30rpx;
  background: rgba(255,255,255,.94);
  box-shadow: 0 18rpx 58rpx rgba(57, 69, 124, .07);
  box-sizing: border-box;
}
.mini-topup-account-top,
.mini-topup-section-head,
.mini-topup-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}
.mini-topup-label {
  color: #8791ad;
  font-size: 21rpx;
  line-height: 1.5;
  font-weight: 620;
}
.mini-topup-account-name {
  margin-top: 8rpx;
  color: #252d50;
  font-size: 27rpx;
  line-height: 1.45;
  font-weight: 680;
  word-break: break-all;
}
.mini-topup-balance {
  flex: 0 0 auto;
  text-align: right;
  color: #8b94b1;
  font-size: 19rpx;
}
.mini-topup-balance text {
  display: block;
  margin-top: 6rpx;
  color: #5148c8;
  font-size: 31rpx;
  font-weight: 760;
}
.mini-topup-account-note {
  margin-top: 18rpx;
  color: #8791ad;
  font-size: 20rpx;
  line-height: 1.6;
}
.mini-topup-account-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.mini-topup-light-button {
  flex: 1 1 260rpx;
  min-width: 0;
  height: 72rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid rgba(112, 106, 204, .20);
  border-radius: 16rpx;
  background: #f6f6ff;
  color: #5b55b9;
  font-size: 22rpx;
  line-height: 72rpx;
  font-weight: 650;
}
.mini-topup-section-title {
  color: #252d50;
  font-size: 31rpx;
  line-height: 1.35;
  font-weight: 740;
}
.mini-topup-section-note {
  margin-top: 8rpx;
  color: #8992ad;
  font-size: 21rpx;
  line-height: 1.6;
}
.mini-topup-currency {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: #f1efff;
  color: #675bd2;
  font-size: 19rpx;
  font-weight: 760;
  letter-spacing: .08em;
}
.topup-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 28rpx 0 0;
}
.topup-option {
  width: calc(50% - 8rpx);
  height: 104rpx;
  margin: 0;
  padding: 0 12rpx;
  border: 2rpx solid #dfe3f5;
  border-radius: 22rpx;
  background: #fff;
  color: #242d50;
  font-size: 34rpx;
  line-height: 100rpx;
  font-weight: 740;
  box-sizing: border-box;
}
.topup-option:disabled { opacity: .48; color: #8992aa; border-color: #e5e8f0; background: #f5f6fa; box-shadow: none; }
.topup-option.selected:disabled { border-color: #e5e8f0; color: #8992aa; background: #f5f6fa; }
.mini-topup-custom-row input:disabled { color: #9aa3b8; opacity: .72; }
.topup-option.selected {
  border-color: #7b68ef;
  background: linear-gradient(135deg, #f3f0ff, #edf3ff);
  color: #5a4bd0;
  box-shadow: 0 10rpx 24rpx rgba(104, 91, 215, .10);
}
.mini-topup-custom { margin-top: 26rpx; }
.mini-topup-custom-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 94rpx;
  margin-top: 12rpx;
  padding: 0 22rpx;
  border: 2rpx solid #dfe3f5;
  border-radius: 20rpx;
  background: #fff;
  box-sizing: border-box;
}
.mini-topup-custom-row text {
  color: #6b5de0;
  font-size: 34rpx;
  font-weight: 760;
}
.mini-topup-custom-row input {
  flex: 1;
  min-width: 0;
  color: #242d50;
  font-size: 31rpx;
  font-weight: 650;
}
.mini-topup-total {
  margin-top: 26rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(120deg, #f3f1ff, #eff5ff);
}
.mini-topup-total-amount {
  margin-top: 5rpx;
  color: #5548cc;
  font-size: 39rpx;
  line-height: 1.3;
  font-weight: 780;
}
.mini-topup-total-note {
  color: #7d88a7;
  font-size: 19rpx;
  line-height: 1.65;
  text-align: right;
}
.mini-topup-notice,
.mini-topup-status {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(119, 113, 190, .14);
  border-radius: 16rpx;
  background: #f8f8ff;
  color: #7d86a2;
  font-size: 21rpx;
  line-height: 1.7;
  word-break: break-word;
}
.mini-topup-status { background: #f7f8fc; }
.mini-topup-action { margin-top: 18rpx; }
.mini-topup-quicklinks {
  display: flex;
  gap: 10rpx;
  margin-top: 20rpx;
}
.mini-topup-quicklinks button {
  flex: 1;
  min-width: 0;
  height: 78rpx;
  margin: 0;
  padding: 0 8rpx;
  border: 1rpx solid #e1e4f2;
  border-radius: 16rpx;
  background: rgba(255,255,255,.84);
  color: #626d8d;
  font-size: 19rpx;
  line-height: 78rpx;
}
.mini-topup-history {
  margin-top: 26rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid rgba(121, 112, 220, .16);
  border-radius: 26rpx;
  background: rgba(255,255,255,.90);
}
.mini-topup-history-row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f7;
  color: #66718f;
  font-size: 22rpx;
}
.mini-topup-empty {
  padding: 24rpx 0 8rpx;
  color: #929bb2;
  font-size: 21rpx;
}
@media (prefers-color-scheme: dark) {
  .mini-topup-page { background: #111421; color: #eef0ff; }
  .mini-topup-title, .mini-topup-account-name, .mini-topup-section-title { color: #eef0ff; }
  .mini-topup-card, .mini-topup-history { background: rgba(27,31,51,.96); border-color: rgba(156,145,255,.22); }
  .mini-topup-brand-tag, .mini-topup-light-button, .mini-topup-quicklinks button { background: #202640; color: #d8d5ff; border-color: rgba(156,145,255,.22); }
  .topup-option, .mini-topup-custom-row { background: #1b2036; color: #eef0ff; border-color: #353c5b; }
  .mini-topup-custom-row input { color: #eef0ff; }
  .mini-topup-total { background: linear-gradient(120deg, #272344, #202a45); }
  .mini-topup-notice, .mini-topup-status { background: #202640; color: #c0c8e3; border-color: #353c5b; }
  .mini-topup-section-note, .mini-topup-subtitle, .mini-topup-account-note, .mini-topup-label, .mini-topup-total-note { color: #aab4d1; }
  .mini-topup-balance text, .mini-topup-total-amount { color: #c6bfff; }
}
.mini-usd-guide { margin-top: 22rpx; }
.mini-usd-guide-action { width: 100%; margin-top: 18rpx; flex: none; }