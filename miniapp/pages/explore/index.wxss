.flow { display:flex; gap:12rpx; margin-top:34rpx; color:rgba(231,238,255,.66); font-size:22rpx; }
.flow text { flex:1; padding:16rpx 8rpx; text-align:center; border-top:1rpx solid rgba(119,223,212,.34); }
.enter-test { margin-top:24rpx; color:#7adfd4; font-size:22rpx; letter-spacing:2rpx; }
.node-row{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:18rpx}.node-row text{border-left:1rpx solid rgba(114,216,207,.52);padding-left:10rpx;color:rgba(219,234,247,.68);font-size:20rpx}
.engine-note{margin-top:30rpx;padding:24rpx;font-size:23rpx;line-height:1.75;color:rgba(235,239,255,.74)}
.engine-title{margin-bottom:14rpx;color:#80e2d7;font-size:26rpx;letter-spacing:2rpx}.engine-paragraph{margin-top:12rpx}.engine-en{margin-top:16rpx;padding-top:14rpx;border-top:1rpx solid rgba(128,226,215,.18);color:rgba(221,229,255,.6);font-size:20rpx;line-height:1.7}.engine-en text,.subtitle-en{display:block}.subtitle-en{margin-top:10rpx;font-family:Georgia,serif;font-size:23rpx;color:rgba(231,237,255,.58)}
.home-intro{margin-top:24rpx;color:rgba(232,237,255,.7);font-size:24rpx;line-height:1.8}.architecture{display:flex;align-items:center;justify-content:center;gap:24rpx;margin-top:26rpx;padding:22rpx;color:rgba(234,240,255,.76);font-size:23rpx}.architecture-count{color:#8be8de;font-family:Georgia,serif;font-size:42rpx}.architecture-plus{color:#d1b3ff;font-size:32rpx}.method-note{margin-top:20rpx;padding:0 6rpx;color:rgba(221,229,255,.54);font-size:21rpx;line-height:1.75}.card-field{margin-bottom:12rpx;color:#79ddd3;font-size:18rpx;letter-spacing:4rpx}.lx-card-name-en{margin-top:5rpx;color:rgba(225,232,255,.52);font-family:Georgia,serif;font-size:20rpx}.card-definition{margin-top:18rpx;color:rgba(241,244,255,.82);font-size:26rpx;line-height:1.65}.convergence-card{border-color:rgba(211,174,255,.4);background:linear-gradient(135deg,rgba(127,91,175,.18),rgba(38,136,146,.12))}.convergence-card .card-field{color:#d4b6ff}.assessment-declaration{margin-top:34rpx;padding:24rpx;color:rgba(222,229,250,.58);font-size:21rpx;line-height:1.8}
