<view class="lx-page"><view class="lx-shell">
  <view class="lx-brand"><view class="lx-brand-name">灵犀场</view><view class="lx-brand-en">LINGXIFIELD</view></view>
  <view class="lx-kicker">{{copy.kicker}}</view><view class="lx-title">{{copy.title}}</view><view class="lx-subtitle">{{copy.subtitle}}</view>
  <view class="lx-section"><view class="lx-section-head"><view class="lx-section-title">{{copy.start}}</view><view class="lx-section-note">{{copy.choose}}</view></view>
    <view class="lx-list"><view wx:for="{{entries}}" wx:key="path" class="lx-row" data-index="{{index}}" bindtap="open"><view class="lx-row-main"><view class="lx-row-title">{{item.title}}</view><view class="lx-row-note">{{item.note}}</view></view><view class="lx-arrow">›</view></view></view>
  </view>
  <view class="lx-feature"><view class="lx-kicker">{{copy.featureKicker}}</view><view class="lx-feature-title">{{copy.featureTitle}}</view><view class="lx-feature-note">{{copy.featureNote}}</view><button class="lx-button secondary" bindtap="openConnections">{{copy.featureButton}}</button></view>
  <view class="lx-share-panel"><view class="lx-share-title">{{copy.shareTitle}}</view><view class="lx-share-note">{{copy.shareNote}}</view><view class="lx-share-actions"><button class="lx-share-button" open-type="share">{{copy.shareFriend}}</button><button class="lx-share-button secondary" bindtap="copyLink">{{copy.copyLink}}</button></view></view>
</view></view>