.archetype-page{padding-bottom:80rpx}.manifesto{margin-top:36rpx;padding:34rpx;font-size:28rpx;line-height:1.9;color:rgba(241,244,255,.78)}.manifesto view+view{margin-top:22rpx}.manifesto .closing{color:#83e5da;letter-spacing:.18em}.progress{margin-top:28rpx;padding:30rpx}.progress-head{display:flex;justify-content:space-between;color:#eafdfa;font-size:30rpx}.track{height:10rpx;margin-top:24rpx;overflow:hidden;border-radius:20rpx;background:rgba(255,255,255,.08)}.fill{height:100%;border-radius:20rpx;background:linear-gradient(90deg,#6ddfd4,#b996ff)}.window{margin-top:18rpx;color:rgba(224,232,255,.58);font-size:23rpx}.tributaries{display:grid;gap:18rpx;margin:28rpx 0}.tributary{display:flex;align-items:center;gap:20rpx;padding:28rpx}.status-dot{width:18rpx;height:18rpx;flex:none;border:2rpx solid rgba(165,177,216,.65);border-radius:50%}.complete .status-dot{border-color:#79e6d8;background:#79e6d8;box-shadow:0 0 18rpx rgba(121,230,216,.55)}.tributary-copy{min-width:0;flex:1}.tributary-name{color:#f4f5ff;font-size:29rpx}.tributary-en{margin-top:4rpx;color:rgba(207,215,245,.52);font-size:21rpx}.tributary-note{margin-top:10rpx;color:rgba(207,215,245,.66);font-size:21rpx;line-height:1.6}.tributary-status{max-width:170rpx;color:#89dfd7;font-size:22rpx;text-align:right}.lx-button{margin-top:26rpx}
.subject-panel{margin-top:28rpx;padding:28rpx}.subject-label{font-size:22rpx;letter-spacing:.16em;color:rgba(207,215,245,.62)}.subject-value{margin-top:16rpx;border:1rpx solid rgba(121,230,216,.4);padding:22rpx;color:#eafdfa;font-size:28rpx}.subject-note{margin-top:14rpx;color:rgba(207,215,245,.58);font-size:21rpx;line-height:1.6}.needs-retest{border-color:rgba(230,201,135,.45)}.needs-retest .tributary-status{color:#e6c987}.blocked{margin:20rpx 0;padding:26rpx;border-left:4rpx solid #e6c987;color:rgba(241,244,255,.74);font-size:23rpx;line-height:1.8}
