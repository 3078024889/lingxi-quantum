.page{min-height:100vh;background:#f4f3ef;padding:48rpx 32rpx;box-sizing:border-box}.card{background:#fff;border:1rpx solid #deddd7;border-radius:32rpx;padding:44rpx}.brand{font-size:24rpx;color:#7b7b74;letter-spacing:2rpx}.title{margin-top:26rpx;font-size:48rpx;font-weight:700;color:#111}.note{margin-top:18rpx;font-size:28rpx;line-height:1.7;color:#6d6d67}.primary,.secondary,.ghost{margin-top:24rpx;border-radius:22rpx;font-size:30rpx}.primary{background:#111;color:#fff}.secondary{background:#fff;color:#111;border:1rpx solid #d8d7d1}.ghost{background:transparent;color:#777}.primary::after,.secondary::after,.ghost::after{border:0}
