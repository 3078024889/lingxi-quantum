<view class="lx-page"><view class="lx-orbit"></view><view class="product-nav"><view class="back" bindtap="back"><text class="back-arrow">‹</text><text>返回</text></view><view class="nav-brand">灵犀场</view><view class="nav-spacer"></view></view>
<view wx:if="{{loading}}" class="lx-loading">正在进入精测…</view><view wx:else class="lx-content assessment">
  <view class="lx-kicker">BEFORE THE ARCHIVE</view><view class="lx-title">{{item.name}}</view><view class="lx-subtitle">{{item.assessmentIntro || '完整报告从真实资料与当下生活坐标共同生长。先看见结构，再决定是否继续。'}}</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{!preview}}" class="form lx-veil">
    <block wx:if="{{assessmentKind === 'daily-tide'}}"><view class="form-title">先看今日星座潮汐</view><view class="form-hint">星座页与网站同步更新，不需要出生资料；完整深读再使用出生日期校准。</view><radio-group class="choice-grid zodiac-grid" bindchange="chooseZodiac"><label wx:for="{{zodiacs}}" wx:key="*this"><radio value="{{item[0]}}" checked="{{zodiac === item[0]}}" color="#72d8cf"/>{{item[1]}}</label></radio-group><button class="lx-button secondary" bindtap="openDailyTide">先查看今日潮汐</button></block>
    <view class="form-title {{assessmentKind === 'daily-tide' ? 'second' : ''}}">{{isRelationship ? '第一位的出生坐标' : (assessmentKind === 'daily-tide' ? '完整潮汐深读校准' : '你的出生坐标')}}</view>
    <input class="field" placeholder="称呼（可选）" value="{{person.name}}" data-key="name" bindinput="inputPerson"/>
    <view class="date-row"><input class="field" type="number" maxlength="4" placeholder="出生年" value="{{person.year}}" data-key="year" bindinput="inputPerson"/><input class="field" type="number" maxlength="2" placeholder="月" value="{{person.month}}" data-key="month" bindinput="inputPerson"/><input class="field" type="number" maxlength="2" placeholder="日" value="{{person.day}}" data-key="day" bindinput="inputPerson"/></view>
    <block wx:if="{{assessmentKind !== 'daily-tide'}}"><view class="switch-row"><text>知道准确出生时间</text><switch color="#72d8cf" checked="{{person.hasTime}}" bindchange="toggleTime"/></view><view wx:if="{{person.hasTime}}" class="date-row"><input class="field" type="number" maxlength="2" placeholder="时" value="{{person.hour}}" data-key="hour" bindinput="inputPerson"/><input class="field" type="number" maxlength="2" placeholder="分" value="{{person.minute}}" data-key="minute" bindinput="inputPerson"/></view></block>
    <block wx:if="{{isRelationship}}"><view class="form-title second">第二位的出生坐标</view><input class="field" placeholder="对方称呼（必填）" value="{{personB.name}}" data-key="name" bindinput="inputPersonB"/><view class="date-row"><input class="field" type="number" maxlength="4" placeholder="出生年" value="{{personB.year}}" data-key="year" bindinput="inputPersonB"/><input class="field" type="number" maxlength="2" placeholder="月" value="{{personB.month}}" data-key="month" bindinput="inputPersonB"/><input class="field" type="number" maxlength="2" placeholder="日" value="{{personB.day}}" data-key="day" bindinput="inputPersonB"/></view><view class="switch-row"><text>知道对方准确出生时间</text><switch color="#72d8cf" checked="{{personB.hasTime}}" bindchange="toggleTimeB"/></view><view wx:if="{{personB.hasTime}}" class="date-row"><input class="field" type="number" maxlength="2" placeholder="时" value="{{personB.hour}}" data-key="hour" bindinput="inputPersonB"/><input class="field" type="number" maxlength="2" placeholder="分" value="{{personB.minute}}" data-key="minute" bindinput="inputPersonB"/></view><radio-group class="relation-types" bindchange="chooseRelation"><label><radio value="romantic" checked color="#72d8cf"/>亲密</label><label><radio value="business" color="#72d8cf"/>合伙</label><label><radio value="general" color="#72d8cf"/>其他</label></radio-group></block>
    <block wx:if="{{assessmentKind === 'life-map'}}"><view class="form-title second">生命图谱的现实坐标</view><view class="form-hint">这些资料与网页生命图谱一致；手机号、车牌号仅用于可选的数字能量附录。</view><input class="field" placeholder="出生城市（可选）" value="{{profile.city}}" data-key="city" bindinput="inputProfile"/><input class="field" placeholder="手机号（可选，仅数字能量附录）" value="{{person.phone}}" data-key="phone" bindinput="inputPerson"/><input class="field" placeholder="车牌号（可选，仅数字能量附录）" value="{{person.plate}}" data-key="plate" bindinput="inputPerson"/><view class="choice-label">目前最接近的生活阶段</view><radio-group class="choice-grid" data-key="currentState" bindchange="chooseProfile"><label><radio value="transforming" color="#72d8cf"/>转化中</label><label><radio value="lost" color="#72d8cf"/>有些迷失</label><label><radio value="breakthrough" color="#72d8cf"/>准备突破</label><label><radio value="stable" color="#72d8cf"/>相对稳定</label><label><radio value="exploring" checked color="#72d8cf"/>正在探索</label></radio-group><view class="choice-label">希望优先照见</view><radio-group class="choice-grid" data-key="focus" bindchange="chooseProfile"><label><radio value="all" checked color="#72d8cf"/>全面探索</label><label><radio value="wealth" color="#72d8cf"/>财富事业</label><label><radio value="relationship" color="#72d8cf"/>感情关系</label><label><radio value="direction" color="#72d8cf"/>人生方向</label><label><radio value="growth" color="#72d8cf"/>内在成长</label></radio-group></block>
    <block wx:if="{{assessmentKind === 'wealth'}}"><view class="form-title second">财富创造的现实坐标</view><input class="field" placeholder="职业 / 正在做的事（可选）" value="{{profile.profession}}" data-key="profession" bindinput="inputProfile"/><view class="choice-label">目前最接近的阶段</view><radio-group class="choice-row compact" data-key="currentState" bindchange="chooseProfile"><label><radio value="exploring" checked color="#72d8cf"/>探索</label><label><radio value="breakthrough" color="#72d8cf"/>突破</label><label><radio value="stable" color="#72d8cf"/>稳定</label></radio-group></block>
    <block wx:if="{{assessmentKind === 'romance'}}"><view class="form-title second">关系时序的现实坐标</view><radio-group class="choice-row compact" data-key="relationshipStatus" bindchange="chooseProfile"><label><radio value="single" color="#72d8cf"/>单身</label><label><radio value="dating" color="#72d8cf"/>接触中</label><label><radio value="married" color="#72d8cf"/>稳定关系</label><label><radio value="complicated" color="#72d8cf"/>复杂中</label></radio-group></block>
    <block wx:if="{{assessmentKind === 'resilience'}}"><view class="form-title second">此刻的恢复状态</view><radio-group class="choice-row compact" data-key="currentState" bindchange="chooseProfile"><label><radio value="lost" color="#72d8cf"/>消耗中</label><label><radio value="transforming" color="#72d8cf"/>调整中</label><label><radio value="stable" color="#72d8cf"/>稳定中</label></radio-group></block>
    <button class="lx-button" disabled="{{calculating}}" loading="{{calculating}}" bindtap="calculate">生成我的初读档案</button><view class="privacy">资料只用于确定性计算与本次档案存储，不会公开展示。</view>
  </view>
  <view wx:if="{{preview}}" id="preview" class="preview lx-veil"><view class="lx-kicker">{{preview.eyebrow}}</view><view class="preview-title">{{preview.title}}</view><view class="preview-insight">{{preview.insight}}</view><view class="trait-row"><view wx:for="{{preview.traits}}" wx:key="label" class="trait"><text>{{item.label}}</text><text>{{item.score}}</text></view></view><view class="boundary">这是由完整资料开始生长的第一层结构；证据链、内部张力、现实映射、反证条件与行动实验将在完整档案中展开。</view><view class="lx-price">完整档案 · ¥ {{item.priceFen / 100}}</view><button class="lx-button" disabled="{{paying}}" loading="{{paying}}" bindtap="pay">解锁这份完整档案</button></view>
</view></view>
