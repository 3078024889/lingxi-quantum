<view class="lx-page"><view class="lx-orbit"></view><view class="product-nav"><view class="back" bindtap="back"><text class="back-arrow">‹</text><text>返回</text></view><view class="nav-brand">灵犀场</view><view class="nav-spacer"></view></view>
<view wx:if="{{loading}}" class="lx-loading">正在进入精测…</view><view wx:else class="lx-content assessment">
  <view class="lx-kicker">BEFORE THE ARCHIVE</view><view class="lx-title">{{item.name}}</view><view class="lx-subtitle">完整报告从真实出生资料与当下生活坐标共同生长。先看见结构，再决定是否继续。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{!preview}}" class="form lx-veil">
    <view class="form-title">{{isRelationship ? '第一位' : '你的出生坐标'}}</view>
    <input class="field" placeholder="称呼（可选）" value="{{person.name}}" data-key="name" bindinput="inputPerson"/>
    <view class="date-row"><input class="field" type="number" maxlength="4" placeholder="出生年" value="{{person.year}}" data-key="year" bindinput="inputPerson"/><input class="field" type="number" maxlength="2" placeholder="月" value="{{person.month}}" data-key="month" bindinput="inputPerson"/><input class="field" type="number" maxlength="2" placeholder="日" value="{{person.day}}" data-key="day" bindinput="inputPerson"/></view>
    <view class="switch-row"><text>知道准确出生时间</text><switch color="#72d8cf" checked="{{person.hasTime}}" bindchange="toggleTime"/></view>
    <view wx:if="{{person.hasTime}}" class="date-row"><input class="field" type="number" maxlength="2" placeholder="时" value="{{person.hour}}" data-key="hour" bindinput="inputPerson"/><input class="field" type="number" maxlength="2" placeholder="分" value="{{person.minute}}" data-key="minute" bindinput="inputPerson"/></view>
    <block wx:if="{{isRelationship}}"><view class="form-title second">第二位</view><input class="field" placeholder="对方称呼（必填）" value="{{personB.name}}" data-key="name" bindinput="inputPersonB"/><view class="date-row"><input class="field" type="number" maxlength="4" placeholder="出生年" value="{{personB.year}}" data-key="year" bindinput="inputPersonB"/><input class="field" type="number" maxlength="2" placeholder="月" value="{{personB.month}}" data-key="month" bindinput="inputPersonB"/><input class="field" type="number" maxlength="2" placeholder="日" value="{{personB.day}}" data-key="day" bindinput="inputPersonB"/></view><view class="switch-row"><text>知道对方准确出生时间</text><switch color="#72d8cf" checked="{{personB.hasTime}}" bindchange="toggleTimeB"/></view><view wx:if="{{personB.hasTime}}" class="date-row"><input class="field" type="number" maxlength="2" placeholder="时" value="{{personB.hour}}" data-key="hour" bindinput="inputPersonB"/><input class="field" type="number" maxlength="2" placeholder="分" value="{{personB.minute}}" data-key="minute" bindinput="inputPersonB"/></view><radio-group class="relation-types" bindchange="chooseRelation"><label><radio value="romantic" checked color="#72d8cf"/>亲密</label><label><radio value="business" color="#72d8cf"/>合伙</label><label><radio value="general" color="#72d8cf"/>其他</label></radio-group></block>
    <view class="form-title second">全面探索坐标</view><view class="form-hint">默认“全面探索”。不知道从哪里开始也没关系；这些坐标让档案能落到你正在经历的现实。</view>
    <input class="field" placeholder="出生城市（可选）" value="{{profile.city}}" data-key="city" bindinput="inputProfile"/>
    <view class="choice-label">性别</view><radio-group class="choice-row" data-key="gender" bindchange="chooseProfile"><label><radio value="female" color="#72d8cf"/>女</label><label><radio value="male" color="#72d8cf"/>男</label><label><radio value="other" color="#72d8cf"/>不限定</label></radio-group>
    <view class="choice-label">目前最接近的生活阶段</view><radio-group class="choice-grid" data-key="currentState" bindchange="chooseProfile"><label><radio value="transforming" color="#72d8cf"/>转化中</label><label><radio value="lost" color="#72d8cf"/>有些迷失</label><label><radio value="breakthrough" color="#72d8cf"/>准备突破</label><label><radio value="stable" color="#72d8cf"/>相对稳定</label><label><radio value="exploring" checked color="#72d8cf"/>正在探索</label></radio-group>
    <view class="choice-label">你希望档案优先照见什么</view><radio-group class="choice-grid" data-key="focus" bindchange="chooseProfile"><label><radio value="all" checked color="#72d8cf"/>全面探索</label><label><radio value="wealth" color="#72d8cf"/>财富事业</label><label><radio value="relationship" color="#72d8cf"/>感情关系</label><label><radio value="direction" color="#72d8cf"/>人生方向</label><label><radio value="growth" color="#72d8cf"/>内在成长</label></radio-group>
    <view class="choice-label">职业与关系状态（可选）</view><input class="field" placeholder="职业 / 正在做的事" value="{{profile.profession}}" data-key="profession" bindinput="inputProfile"/><radio-group class="choice-row compact" data-key="relationshipStatus" bindchange="chooseProfile"><label><radio value="single" color="#72d8cf"/>单身</label><label><radio value="dating" color="#72d8cf"/>接触中</label><label><radio value="married" color="#72d8cf"/>稳定关系</label><label><radio value="complicated" color="#72d8cf"/>复杂中</label></radio-group>
    <view class="choice-label">日常自我观察 / 修炼</view><radio-group class="choice-row compact" data-key="practiceStatus" bindchange="chooseProfile"><label><radio value="regular" color="#72d8cf"/>规律</label><label><radio value="occasional" color="#72d8cf"/>偶尔</label><label><radio value="curious" color="#72d8cf"/>正在了解</label><label><radio value="none" color="#72d8cf"/>尚未开始</label></radio-group>
    <view class="choice-label">此刻能量 / 清晰 / 对齐程度</view><view class="level-row"><view><text>能量</text><view class="level-pips"><text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" data-key="energyLevel" data-value="{{item}}" bindtap="chooseLevel" class="{{profile.energyLevel >= item ? 'level-on' : ''}}">●</text></view></view><view><text>清晰</text><view class="level-pips"><text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" data-key="clarityLevel" data-value="{{item}}" bindtap="chooseLevel" class="{{profile.clarityLevel >= item ? 'level-on' : ''}}">●</text></view></view><view><text>对齐</text><view class="level-pips"><text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" data-key="alignmentLevel" data-value="{{item}}" bindtap="chooseLevel" class="{{profile.alignmentLevel >= item ? 'level-on' : ''}}">●</text></view></view></view>
    <block wx:if="{{isRelationship}}"><view class="choice-label">这段关系目前最接近</view><radio-group class="choice-row compact" data-key="relationshipStage" bindchange="chooseProfile"><label><radio value="understanding" checked color="#72d8cf"/>彼此了解</label><label><radio value="deepening" color="#72d8cf"/>正在深化</label><label><radio value="tension" color="#72d8cf"/>存在张力</label><label><radio value="repair" color="#72d8cf"/>尝试修复</label></radio-group></block>
    <button class="lx-button" disabled="{{calculating}}" loading="{{calculating}}" bindtap="calculate">生成我的初读档案</button><view class="privacy">出生信息用于确定性计算；探索坐标用于本次报告的现实映射与存档，不会公开展示。</view>
  </view>
  <view wx:if="{{preview}}" id="preview" class="preview lx-veil"><view class="lx-kicker">{{preview.eyebrow}}</view><view class="preview-title">{{preview.title}}</view><view class="preview-insight">{{preview.insight}}</view><view class="trait-row"><view wx:for="{{preview.traits}}" wx:key="label" class="trait"><text>{{item.label}}</text><text>{{item.score}}</text></view></view><view class="boundary">这是由完整资料开始生长的第一层结构；证据链、内部张力、现实映射、反证条件与行动实验将在完整档案中展开。</view><view class="lx-price">完整档案 · ¥ {{item.priceFen / 100}}</view><button class="lx-button" disabled="{{paying}}" loading="{{paying}}" bindtap="pay">解锁这份完整档案</button></view>
</view></view>
