<view class="lx-page"><field-nav show-back="{{true}}" title="场域精测"/><view class="lx-content assessment">
  <view wx:if="{{loading}}" class="lx-loading">正在连接树突场域…</view>
  <view wx:elif="{{error && !product}}" class="lx-empty lx-veil">{{error}}</view>
  <block wx:elif="{{product}}">
    <view class="topline"><view class="lx-kicker">FIELD {{product.field}} · {{product.layer === 'convergence' ? (lang === 'zh' ? '汇流层' : 'CONVERGENCE') : 'FIELD INSIGHT'}}</view><button class="lang" bindtap="toggleLang">{{lang === 'zh' ? 'EN' : '中'}}</button></view>
    <view class="lx-title">{{product.nameZh}}</view>
    <view class="product-name-en">{{product.nameEn}}</view>
    <view class="core-title">{{lang === 'zh' ? product.coreTitleZh : product.coreTitleEn}}</view>
    <view class="overview"><view wx:for="{{lang === 'zh' ? product.overviewZh : product.overviewEn}}" wx:key="*this">{{item}}</view></view>
    <view class="reading-note lx-veil"><view class="reading-title">{{lang === 'zh' ? '本产品读取什么' : 'WHAT THIS PRODUCT READS'}}</view><view>{{lang === 'zh' ? product.readingZh : product.readingEn}}</view></view>
    <view class="structure-row"><text wx:for="{{lang === 'zh' ? product.structureZh : product.structureEn}}" wx:key="*this">{{item}}</text></view>
    <view class="duration">{{engine.questionCount}} {{lang === 'zh' ? '个结构节点 · 约' : 'structural interactions · about'}} {{engine.estimatedMinutes}} {{lang === 'zh' ? '分钟' : 'min'}}</view>

    <view wx:if="{{!result}}" class="panel lx-veil">
      <view class="identity-block">
        <view class="identity-label">{{product.productId === 'relationship-resonance' ? (lang === 'zh' ? '关系双方 · 用于生成专属档案' : 'BOTH PEOPLE · FOR THE PERSONAL ARCHIVE') : (lang === 'zh' ? '档案称呼 · 用于写入我的场域' : 'ARCHIVE NAME · SAVED TO MY FIELD')}}</view>
        <input type="text" value="{{name}}" maxlength="40" cursor-spacing="120" bindinput="inputName" placeholder="{{lang === 'zh' ? '你的姓名或称呼（必填）' : 'Your name or preferred name *'}}" placeholder-style="color:rgba(224,232,255,.46)"/>
        <input wx:if="{{product.productId === 'relationship-resonance'}}" type="text" value="{{partnerName}}" maxlength="40" cursor-spacing="120" bindinput="inputPartner" placeholder="{{lang === 'zh' ? '对方姓名或称呼（必填）' : 'Other person *'}}" placeholder-style="color:rgba(224,232,255,.46)"/>
      </view>
      <view wx:if="{{product.productId === 'relationship-resonance'}}" class="relationship-variant">
        <view class="variant-note">{{lang === 'zh' ? '请选择真实关系类型。三类入口分别读取不同的 24 个结构节点。' : 'Choose the lived relationship. Each path uses its own 24 interactions.'}}</view>
        <view class="relation-types"><text class="{{relationshipType === 'deep' ? 'active' : ''}}" data-value="deep" bindtap="chooseRelationship">深度关系</text><text class="{{relationshipType === 'business' ? 'active' : ''}}" data-value="business" bindtap="chooseRelationship">合伙商业</text><text class="{{relationshipType === 'other' ? 'active' : ''}}" data-value="other" bindtap="chooseRelationship">其他关系</text></view>
      </view>
      <view class="progress"><view style="width: {{(questionIndex + 1) * 100 / product.questions.length}}%"></view></view>
      <view class="counter">{{questionIndex + 1}} / {{product.questions.length}}</view>
      <view class="question-section">{{lang === 'zh' ? product.questions[questionIndex].sectionZh : product.questions[questionIndex].sectionEn}}</view>
      <view class="question">{{lang === 'zh' ? product.questions[questionIndex].zh : product.questions[questionIndex].en}}</view>
      <view class="options"><view wx:for="{{product.questions[questionIndex].options}}" wx:key="id" class="option {{selected === item.id ? 'selected' : ''}}" data-value="{{item.id}}" bindtap="choose"><view class="orb"></view><text>{{lang === 'zh' ? item.zh : item.en}}</text></view></view>
      <view class="option custom-option {{selected === '__custom__' ? 'selected' : ''}}" data-value="__custom__" bindtap="choose"><view class="orb"></view><text>{{lang === 'zh' ? '以上都不贴近 · 写下我自己的答案' : 'None fits · Write my own answer'}}</text></view>
      <textarea wx:if="{{selected === '__custom__'}}" class="custom-answer" value="{{customAnswer}}" maxlength="240" cursor-spacing="140" auto-height bindinput="inputCustom" placeholder="{{lang === 'zh' ? '请用自己的话写下此刻真实的答案（2—240 字）' : 'Write the answer that is true for you (2–240 characters)'}}" placeholder-style="color:rgba(224,232,255,.42)"/>
      <view class="actions"><button wx:if="{{questionIndex > 0}}" class="ghost" bindtap="previous">{{lang === 'zh' ? '返回' : 'Back'}}</button><button class="next" loading="{{submitting}}" disabled="{{submitting}}" bindtap="next">{{questionIndex + 1 === product.questions.length ? (lang === 'zh' ? product.ctaZh : product.ctaEn) : (lang === 'zh' ? '继续' : 'Continue')}}</button></view>
      <view wx:if="{{error}}" class="error">{{error}}</view>
    </view>

    <view wx:else class="result lx-veil">
      <view class="result-kicker">{{lang === 'zh' ? '此刻的连接结构' : 'CURRENT CONNECTED STRUCTURE'}}</view>
      <view class="result-title">{{lang === 'zh' ? result.titleZh : result.titleEn}}</view>
      <view class="nodes"><view wx:for="{{result.nodes}}" wx:key="id" class="node"><view class="node-label"><text>{{lang === 'zh' ? item.zh : item.en}}</text><text>{{item.score}}</text></view><view class="bar"><view style="width: {{item.score}}%"></view></view></view></view>
      <view class="insight">{{lang === 'zh' ? result.insightZh : result.insightEn}}</view>
      <view class="chapters"><view wx:for="{{result.chapters}}" wx:key="id" class="chapter"><view class="chapter-title">{{lang === 'zh' ? item.titleZh : item.titleEn}}</view><view class="chapter-body">{{lang === 'zh' ? item.bodyZh : item.bodyEn}}</view></view></view>
      <view class="evidence">{{lang === 'zh' ? '本次读取' : 'This reading'}} · {{result.evidence.answered}} / {{result.evidence.total}}<text wx:if="{{result.evidence.historyProducts > 0}}"> · {{lang === 'zh' ? '已连接历史场域' : 'history fields linked'}} {{result.evidence.historyProducts}}</text></view>
      <view wx:if="{{result.cardRolesZh}}" class="archetype-roles"><text wx:for="{{lang === 'zh' ? result.cardRolesZh : result.cardRolesEn}}" wx:key="*this">{{item}}</text></view>
      <button wx:if="{{unlocked}}" class="lx-button" bindtap="openUnlockedReport"><text>{{lang === 'zh' ? '打开完整' : 'Open Full '}}</text><text>{{lang === 'zh' ? product.nameZh : product.nameEn}}</text><text>{{lang === 'zh' ? '报告' : ' Report'}}</text></button>
      <button wx:else class="lx-button" loading="{{paying}}" disabled="{{paying}}" bindtap="pay"><text>{{lang === 'zh' ? '保存完整' : 'Save Full '}}</text><text>{{lang === 'zh' ? product.nameZh : product.nameEn}}</text><text>{{lang === 'zh' ? '至场域档案' : ' to My Field'}}</text> · ¥{{item.priceFen / 100}}</button>
      <view class="share-actions"><button open-type="share">{{lang === 'zh' ? '转发分享' : 'Share'}}</button><button bindtap="copyWebLink">{{lang === 'zh' ? '复制官网链接' : 'Copy web link'}}</button><button bindtap="restart">{{lang === 'zh' ? '重新观测' : 'Restart'}}</button></view>
    </view>
  </block>
</view></view>
