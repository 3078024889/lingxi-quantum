<view class="lx-page"><view class="lx-orbit"></view><view class="product-nav"><view class="back" bindtap="back"><text class="back-arrow">‹</text><text>返回</text></view><view class="nav-brand">灵犀场</view><view class="nav-spacer"></view></view>
<view wx:if="{{loading}}" class="lx-loading">正在进入精测…</view><view wx:else class="lx-content assessment">
  <view class="lx-kicker">BEFORE THE ARCHIVE</view><view class="lx-title">{{item.name}}</view><view class="lx-subtitle">完整报告必须从你的真实资料生长出来。先看见一层结构，再决定是否继续。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{!preview}}" class="form lx-veil">
    <view class="form-title">{{isRelationship ? '第一位' : '你的资料'}}</view>
    <input class="field" placeholder="称呼（可选）" value="{{person.name}}" data-key="name" bindinput="inputPerson"/>
    <view class="date-row"><input class="field" type="number" maxlength="4" placeholder="出生年" value="{{person.year}}" data-key="year" bindinput="inputPerson"/><input class="field" type="number" maxlength="2" placeholder="月" value="{{person.month}}" data-key="month" bindinput="inputPerson"/><input class="field" type="number" maxlength="2" placeholder="日" value="{{person.day}}" data-key="day" bindinput="inputPerson"/></view>
    <view class="switch-row"><text>知道准确出生时间</text><switch color="#72d8cf" checked="{{person.hasTime}}" bindchange="toggleTime"/></view>
    <view wx:if="{{person.hasTime}}" class="date-row"><input class="field" type="number" maxlength="2" placeholder="时" value="{{person.hour}}" data-key="hour" bindinput="inputPerson"/><input class="field" type="number" maxlength="2" placeholder="分" value="{{person.minute}}" data-key="minute" bindinput="inputPerson"/></view>
    <block wx:if="{{isRelationship}}"><view class="form-title second">第二位</view><input class="field" placeholder="对方称呼（必填）" value="{{personB.name}}" data-key="name" bindinput="inputPersonB"/><view class="date-row"><input class="field" type="number" maxlength="4" placeholder="出生年" value="{{personB.year}}" data-key="year" bindinput="inputPersonB"/><input class="field" type="number" maxlength="2" placeholder="月" value="{{personB.month}}" data-key="month" bindinput="inputPersonB"/><input class="field" type="number" maxlength="2" placeholder="日" value="{{personB.day}}" data-key="day" bindinput="inputPersonB"/></view><view class="switch-row"><text>知道对方准确出生时间</text><switch color="#72d8cf" checked="{{personB.hasTime}}" bindchange="toggleTimeB"/></view><view wx:if="{{personB.hasTime}}" class="date-row"><input class="field" type="number" maxlength="2" placeholder="时" value="{{personB.hour}}" data-key="hour" bindinput="inputPersonB"/><input class="field" type="number" maxlength="2" placeholder="分" value="{{personB.minute}}" data-key="minute" bindinput="inputPersonB"/></view><radio-group class="relation-types" bindchange="chooseRelation"><label><radio value="romantic" checked color="#72d8cf"/>亲密</label><label><radio value="business" color="#72d8cf"/>合伙</label><label><radio value="general" color="#72d8cf"/>其他</label></radio-group></block>
    <textarea class="field focus" maxlength="120" placeholder="此刻最想看清什么？（可选）" value="{{focus}}" bindinput="inputFocus"></textarea>
    <button class="lx-button" disabled="{{calculating}}" loading="{{calculating}}" bindtap="calculate">生成我的初步结构</button><view class="privacy">资料只用于本次确定性计算与报告存档，不用于公开展示。</view>
  </view>
  <view wx:if="{{preview}}" id="preview" class="preview lx-veil"><view class="lx-kicker">{{preview.eyebrow}}</view><view class="preview-title">{{preview.title}}</view><view class="preview-insight">{{preview.insight}}</view><view class="trait-row"><view wx:for="{{preview.traits}}" wx:key="label" class="trait"><text>{{item.label}}</text><text>{{item.score}}</text></view></view><view class="boundary">你现在看到的是结构初读。证据链、内部张力、现实映射、反证条件与行动实验只在完整档案中展开。</view><view class="lx-price">完整档案 · ¥ {{item.priceFen / 100}}</view><button class="lx-button" disabled="{{paying}}" loading="{{paying}}" bindtap="pay">解锁这份完整档案</button></view>
</view></view>
