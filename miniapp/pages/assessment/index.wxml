<view class="lx-page">
  <view class="lx-orbit"></view>
  <view class="product-nav">
    <view class="back" bindtap="back"><text class="back-arrow">‹</text>返回</view>
    <view class="nav-brand">灵犀场</view><view class="nav-spacer"></view>
  </view>
  <scroll-view scroll-y class="assessment">
    <view class="lx-shell form" wx:if="{{item}}">
      <view class="lx-eyebrow">BEFORE THE ARCHIVE</view>
      <view class="form-title">{{item.name}}</view>
      <view class="form-hint">{{item.assessmentIntro}}</view>
      <view wx:if="{{item.knowledgeNodes && item.knowledgeNodes.length}}" class="archive-path">
        <view class="archive-path-label">本次档案将经过</view>
        <view class="archive-path-nodes">
          <view wx:for="{{item.knowledgeNodes}}" wx:for-item="node" wx:key="*this" class="archive-path-node"><text>{{node}}</text></view>
        </view>
      </view>
      <view class="form-hint">资料只用于本次结构计算与档案生成，不会公开展示。</view>

      <block wx:if="{{assessmentKind === 'daily-tide'}}">
        <view class="form-title second">先读取今日节奏</view>
        <view class="form-hint">今日潮汐的第一层由星座进入。选择后即可阅读当日的行动、关系与观察窗口；出生资料只用于可选的个人深读。</view>
        <view class="choice-label">你的星座</view>
        <radio-group class="choice-grid zodiac-grid" bindchange="chooseZodiac">
          <label wx:for="{{zodiacs}}" wx:key="index"><radio value="{{item[0]}}" checked="{{zodiac === item[0]}}" color="#72d8cf" />{{item[1]}}</label>
        </radio-group>
        <button class="lx-button secondary" bindtap="openDailyTide">先阅读今日潮汐 →</button>
        <view class="daily-deep">
          <view><text>需要更个人化的深读</text><text>可补充出生资料，生成个人潮汐镜像</text></view>
          <switch checked="{{dailyCalibrated}}" color="#72d8cf" bindchange="toggleDailyCalibration" />
        </view>
      </block>

      <block wx:if="{{assessmentKind !== 'daily-tide' || dailyCalibrated}}">
        <view class="form-title second">你的出生坐标</view>
        <input class="field" placeholder="称呼（可选）" placeholder-class="placeholder" value="{{person.name}}" data-key="name" bindinput="inputPerson" />
        <view class="date-row"><input class="field" type="number" placeholder="出生年" placeholder-class="placeholder" value="{{person.year}}" data-key="year" bindinput="inputPerson" /><input class="field" type="number" placeholder="月" placeholder-class="placeholder" value="{{person.month}}" data-key="month" bindinput="inputPerson" /><input class="field" type="number" placeholder="日" placeholder-class="placeholder" value="{{person.day}}" data-key="day" bindinput="inputPerson" /></view>
        <view class="switch-row"><text>知道准确出生时间</text><switch checked="{{person.hasTime}}" color="#72d8cf" bindchange="toggleTime" /></view>
        <view wx:if="{{person.hasTime}}" class="date-row"><input class="field" type="number" placeholder="时" placeholder-class="placeholder" value="{{person.hour}}" data-key="hour" bindinput="inputPerson" /><input class="field" type="number" placeholder="分" placeholder-class="placeholder" value="{{person.minute}}" data-key="minute" bindinput="inputPerson" /></view>

        <block wx:if="{{assessmentKind === 'relationship'}}">
          <view class="form-title second">关系坐标</view>
          <radio-group class="relation-types" bindchange="chooseRelation"><label><radio value="romantic" checked="{{relationshipType === 'romantic'}}" color="#72d8cf" />亲密关系</label><label><radio value="business" checked="{{relationshipType === 'business'}}" color="#72d8cf" />合伙商业</label><label><radio value="other" checked="{{relationshipType === 'other'}}" color="#72d8cf" />其他关系</label></radio-group>
          <input class="field" placeholder="对方称呼（可选）" placeholder-class="placeholder" value="{{personB.name}}" data-key="name" bindinput="inputPersonB" />
          <view class="date-row"><input class="field" type="number" placeholder="对方出生年" placeholder-class="placeholder" value="{{personB.year}}" data-key="year" bindinput="inputPersonB" /><input class="field" type="number" placeholder="月" placeholder-class="placeholder" value="{{personB.month}}" data-key="month" bindinput="inputPersonB" /><input class="field" type="number" placeholder="日" placeholder-class="placeholder" value="{{personB.day}}" data-key="day" bindinput="inputPersonB" /></view>
          <view class="switch-row"><text>知道对方准确出生时间</text><switch checked="{{personB.hasTime}}" color="#72d8cf" bindchange="toggleTimeB" /></view>
          <view wx:if="{{personB.hasTime}}" class="date-row"><input class="field" type="number" placeholder="对方出生时" placeholder-class="placeholder" value="{{personB.hour}}" data-key="hour" bindinput="inputPersonB" /><input class="field" type="number" placeholder="分" placeholder-class="placeholder" value="{{personB.minute}}" data-key="minute" bindinput="inputPersonB" /></view>
        </block>

        <block wx:if="{{assessmentKind === 'life-map'}}">
          <view class="form-title second">生命图谱的现实坐标</view>
          <view class="form-hint">这些资料与网页版生命图谱一致：手机号、车牌号仅用于可选的数字能量附录。</view>
          <input class="field" placeholder="出生城市（可选）" placeholder-class="placeholder" value="{{profile.city}}" data-key="city" bindinput="inputProfile" />
          <radio-group class="choice-row" data-key="gender" bindchange="chooseProfile"><label><radio value="女" checked="{{profile.gender === '女'}}" color="#72d8cf" />女</label><label><radio value="男" checked="{{profile.gender === '男'}}" color="#72d8cf" />男</label><label><radio value="不限定" checked="{{profile.gender === '不限定'}}" color="#72d8cf" />不限定</label></radio-group>
          <input class="field" placeholder="职业 / 正在做的事（可选）" placeholder-class="placeholder" value="{{profile.profession}}" data-key="profession" bindinput="inputProfile" />
          <input class="field" type="number" placeholder="手机号（可选，仅数字能量附录）" placeholder-class="placeholder" value="{{person.phone}}" data-key="phone" bindinput="inputPerson" />
          <input class="field" placeholder="车牌号（可选，仅数字能量附录）" placeholder-class="placeholder" value="{{person.plate}}" data-key="plate" bindinput="inputPerson" />
          <view class="choice-label">目前最接近的生活阶段</view>
          <radio-group class="choice-grid" data-key="currentState" bindchange="chooseProfile"><label><radio value="转化中" checked="{{profile.currentState === '转化中'}}" color="#72d8cf" />转化中</label><label><radio value="有些迷失" checked="{{profile.currentState === '有些迷失'}}" color="#72d8cf" />有些迷失</label><label><radio value="准备突破" checked="{{profile.currentState === '准备突破'}}" color="#72d8cf" />准备突破</label><label><radio value="相对稳定" checked="{{profile.currentState === '相对稳定'}}" color="#72d8cf" />相对稳定</label><label><radio value="正在探索" checked="{{profile.currentState === '正在探索'}}" color="#72d8cf" />正在探索</label></radio-group>
          <view class="choice-label">希望优先看见</view>
          <radio-group class="choice-grid" data-key="focus" bindchange="chooseProfile"><label><radio value="全面探索" checked="{{profile.focus === '全面探索'}}" color="#72d8cf" />全面探索</label><label><radio value="财富事业" checked="{{profile.focus === '财富事业'}}" color="#72d8cf" />财富事业</label><label><radio value="亲密关系" checked="{{profile.focus === '亲密关系'}}" color="#72d8cf" />亲密关系</label><label><radio value="人生方向" checked="{{profile.focus === '人生方向'}}" color="#72d8cf" />人生方向</label><label><radio value="内在成长" checked="{{profile.focus === '内在成长'}}" color="#72d8cf" />内在成长</label></radio-group>
        </block>

        <block wx:if="{{assessmentKind === 'wealth'}}">
          <view class="form-title second">价值创造坐标</view>
          <input class="field" placeholder="目前的职业 / 创造方向（可选）" placeholder-class="placeholder" value="{{profile.profession}}" data-key="profession" bindinput="inputProfile" />
          <view class="choice-label">目前最想突破的环节</view>
          <radio-group class="choice-grid" data-key="focus" bindchange="chooseProfile"><label><radio value="发现价值" checked="{{profile.focus === '发现价值'}}" color="#72d8cf" />发现价值</label><label><radio value="构建表达" checked="{{profile.focus === '构建表达'}}" color="#72d8cf" />构建表达</label><label><radio value="资源连接" checked="{{profile.focus === '资源连接'}}" color="#72d8cf" />资源连接</label><label><radio value="留存复制" checked="{{profile.focus === '留存复制'}}" color="#72d8cf" />留存复制</label></radio-group>
        </block>

        <block wx:if="{{assessmentKind === 'romance'}}">
          <view class="form-title second">关系吸引坐标</view>
          <view class="choice-label">此刻更接近的状态</view>
          <radio-group class="choice-grid" data-key="currentState" bindchange="chooseProfile"><label><radio value="尚未开始" checked="{{profile.currentState === '尚未开始'}}" color="#72d8cf" />尚未开始</label><label><radio value="产生兴趣" checked="{{profile.currentState === '产生兴趣'}}" color="#72d8cf" />产生兴趣</label><label><radio value="关系靠近" checked="{{profile.currentState === '关系靠近'}}" color="#72d8cf" />关系靠近</label><label><radio value="投入后收缩" checked="{{profile.currentState === '投入后收缩'}}" color="#72d8cf" />投入后收缩</label></radio-group>
        </block>

        <block wx:if="{{assessmentKind === 'resilience'}}">
          <view class="form-title second">当下恢复坐标</view>
          <view class="choice-label">最近面对的变化</view>
          <radio-group class="choice-grid" data-key="currentState" bindchange="chooseProfile"><label><radio value="压力累积" checked="{{profile.currentState === '压力累积'}}" color="#72d8cf" />压力累积</label><label><radio value="正在恢复" checked="{{profile.currentState === '正在恢复'}}" color="#72d8cf" />正在恢复</label><label><radio value="环境变化" checked="{{profile.currentState === '环境变化'}}" color="#72d8cf" />环境变化</label><label><radio value="需要重启" checked="{{profile.currentState === '需要重启'}}" color="#72d8cf" />需要重启</label></radio-group>
        </block>
      </block>

      <view class="error" wx:if="{{error}}">{{error}}</view>
      <button wx:if="{{assessmentKind !== 'daily-tide' || dailyCalibrated}}" class="lx-button" bindtap="calculate">生成我的初读档案</button>
      <view class="privacy">资料仅用于本次结构计算与本次档案存储。不会公开展示。</view>
    </view>

    <view wx:if="{{preview}}" id="preview" class="lx-shell preview">
      <view class="lx-eyebrow">YOUR FIRST REFLECTION</view>
      <view class="preview-title">{{preview.title}}</view>
      <view class="preview-insight">{{preview.insight}}</view>
      <view class="trait-row"><view class="trait" wx:for="{{preview.traits}}" wx:key="name"><text>{{item.name}}</text><text>{{item.value}}</text></view></view>
      <view class="boundary">这是第一层结构观察；完整档案会呈现结构证据、现实映射、反证条件与行动实验。</view>
      <button class="lx-button" bindtap="pay">{{item.assessmentCta || '解锁这份完整档案'}}</button>
    </view>
  </scroll-view>
</view>
