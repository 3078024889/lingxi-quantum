.assessment{padding-bottom:100rpx}.topline{display:flex;align-items:center;justify-content:space-between}.lang{margin:0;padding:0 22rpx;min-width:76rpx;line-height:52rpx;border:1rpx solid rgba(122,223,212,.45);background:transparent;color:#bdf4ed;font-size:22rpx}.lang::after{border:0}.product-name-en{margin-top:5rpx;color:rgba(225,232,255,.54);font-family:Georgia,serif;font-size:24rpx}.core-title{margin-top:30rpx;font-family:Georgia,"Noto Serif SC",serif;font-size:34rpx;line-height:1.55;color:#f1f4ff}.overview{margin-top:22rpx;color:rgba(232,237,255,.7);font-size:23rpx;line-height:1.8}.overview view+view{margin-top:14rpx}.reading-note{margin-top:24rpx;padding:24rpx;color:rgba(235,239,255,.72);font-size:23rpx;line-height:1.75}.reading-title{margin-bottom:10rpx;color:#83e6dc;font-size:19rpx;letter-spacing:3rpx}.structure-row{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:18rpx}.structure-row text{padding:8rpx 13rpx;border:1rpx solid rgba(122,223,212,.2);color:rgba(217,237,243,.65);font-size:19rpx}.duration{margin-top:16rpx;color:#7adfd4;font-size:20rpx;letter-spacing:1rpx}.panel,.result{margin-top:28rpx;padding:30rpx}.identity-block input{box-sizing:border-box;width:100%;margin-bottom:14rpx;padding:22rpx;border:1rpx solid rgba(255,255,255,.15);background:rgba(5,15,40,.55);color:#eef1ff}.relation-types{display:flex;gap:10rpx;margin-bottom:30rpx}.relation-types text{flex:1;padding:14rpx 8rpx;border:1rpx solid rgba(255,255,255,.14);text-align:center;font-size:20rpx;color:rgba(235,239,255,.58)}.relation-types .active{border-color:#7adfd4;color:#c9fff9;background:rgba(74,180,171,.14)}.progress{height:4rpx;background:rgba(255,255,255,.1)}.progress view{height:100%;background:linear-gradient(90deg,#7adfd4,#c6a0ff);transition:width .35s}.counter{margin-top:18rpx;color:rgba(221,229,255,.48);font-size:20rpx;letter-spacing:3rpx}.question-section{margin-top:28rpx;color:#7adfd4;font-size:20rpx;letter-spacing:3rpx}.question{margin:14rpx 0 30rpx;font-size:34rpx;line-height:1.55}.options{display:grid;gap:14rpx}.option{display:flex;align-items:center;gap:18rpx;padding:24rpx;border:1rpx solid rgba(255,255,255,.14);background:rgba(6,16,42,.38);font-size:26rpx;color:rgba(238,241,255,.76)}.option.selected{border-color:#7adfd4;background:rgba(69,177,168,.14);color:#f4ffff}.orb{width:18rpx;height:18rpx;border:1rpx solid #8bded7;border-radius:50%;box-shadow:0 0 18rpx rgba(122,223,212,.35)}.selected .orb{background:#9af0e6;box-shadow:0 0 24rpx #7adfd4}.actions{display:flex;gap:16rpx;margin-top:30rpx}.actions button{flex:1;font-size:24rpx}.ghost{border:1rpx solid rgba(255,255,255,.2);background:transparent;color:#dbe2f7}.next{border:1rpx solid rgba(122,223,212,.6);background:rgba(62,165,163,.19);color:#e2fffb}.error{margin-top:20rpx;color:#ff9aaf;font-size:23rpx}.result-kicker{color:#7adfd4;font-size:20rpx;letter-spacing:4rpx}.result-title{margin:24rpx 0 34rpx;font-family:Georgia,serif;font-size:38rpx;line-height:1.45}.node{margin-bottom:18rpx}.node-label{display:flex;justify-content:space-between;color:rgba(235,239,255,.72);font-size:23rpx}.bar{height:8rpx;margin-top:8rpx;border-radius:8rpx;background:rgba(255,255,255,.08);overflow:hidden}.bar view{height:100%;background:linear-gradient(90deg,#62d6cb,#b792f1)}.insight{margin-top:30rpx;padding-top:24rpx;border-top:1rpx solid rgba(255,255,255,.1);font-size:25rpx;line-height:1.9;color:rgba(235,239,255,.76)}.chapters{margin-top:24rpx}.chapter{margin-top:16rpx;padding:22rpx;border-left:2rpx solid rgba(122,223,212,.5);background:rgba(255,255,255,.035)}.chapter-title{color:#bdf4ed;font-size:25rpx}.chapter-body{margin-top:10rpx;color:rgba(235,239,255,.68);font-size:23rpx;line-height:1.75}.evidence{margin-top:22rpx;color:rgba(220,227,250,.48);font-size:19rpx}.archetype-roles{display:flex;justify-content:space-between;margin-top:24rpx;color:#d9bc83;font-size:18rpx}.share-actions{display:flex;gap:10rpx;margin-top:20rpx}.share-actions button{flex:1;padding:0;background:transparent;border:1rpx solid rgba(255,255,255,.17);color:rgba(235,239,255,.68);font-size:20rpx;line-height:64rpx}.share-actions button::after{border:0}
