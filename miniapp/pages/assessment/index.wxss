.product-nav{position:relative;z-index:4;padding:calc(env(safe-area-inset-top) + 24rpx) 30rpx 20rpx;display:flex;align-items:center}.back,.nav-spacer{width:150rpx}.back{color:rgba(238,239,255,.7);font-size:26rpx}.back-arrow{font-size:46rpx;vertical-align:-4rpx;margin-right:10rpx}.nav-brand{flex:1;text-align:center;color:#d7c9a9;letter-spacing:8rpx}.assessment{padding-bottom:100rpx}.form,.preview{margin-top:40rpx;padding:38rpx 30rpx}.form-title{font-size:28rpx;color:#e9ddb9;letter-spacing:4rpx;margin-bottom:22rpx}.form-title.second{margin-top:42rpx}.field{box-sizing:border-box;width:100%;min-height:84rpx;margin-top:16rpx;padding:20rpx 22rpx;color:#f3f3ff;background:rgba(4,15,40,.28);border:1rpx solid rgba(255,255,255,.16);border-radius:4rpx;font-size:27rpx}.date-row{display:flex;gap:14rpx}.date-row .field{flex:1;min-width:0}.switch-row{display:flex;align-items:center;justify-content:space-between;padding:25rpx 4rpx;color:rgba(239,241,255,.72);font-size:25rpx}.relation-types{display:flex;justify-content:space-between;margin-top:24rpx;color:rgba(239,241,255,.72);font-size:24rpx}.privacy,.boundary{margin-top:24rpx;color:rgba(235,239,255,.5);font-size:21rpx;line-height:1.7}.error{margin-top:24rpx;padding:20rpx;color:#ffd7d7;border-left:2rpx solid #c77d83;background:rgba(118,42,59,.18)}.preview-title{font-size:38rpx;line-height:1.45;margin:24rpx 0;color:#f2ead4}.preview-insight{font-size:28rpx;line-height:1.9;color:rgba(241,242,255,.82)}.trait-row{display:flex;gap:12rpx;margin-top:30rpx}.trait{flex:1;padding:18rpx 10rpx;display:flex;flex-direction:column;gap:9rpx;text-align:center;border-top:1rpx solid rgba(116,220,210,.45);font-size:21rpx;color:rgba(235,239,255,.68)}.form-hint{color:rgba(235,239,255,.6);font-size:22rpx;line-height:1.75;margin-bottom:16rpx}.choice-label{margin:30rpx 0 12rpx;color:#e9ddb9;font-size:24rpx;letter-spacing:1rpx}.choice-row,.choice-grid{display:flex;gap:16rpx;flex-wrap:wrap;color:rgba(239,241,255,.78);font-size:23rpx;line-height:1.8}.choice-grid label{width:calc(50% - 8rpx)}.choice-row.compact{gap:12rpx}.choice-row radio,.choice-grid radio{transform:scale(.8);margin-right:3rpx}.level-row{display:flex;justify-content:space-between;gap:12rpx;padding:18rpx 0;color:rgba(239,241,255,.72);font-size:21rpx}.level-row>view{flex:1;text-align:center}.level-pips{display:flex;justify-content:center;gap:5rpx;margin-top:8rpx;color:rgba(255,255,255,.18)}.level-pips text{font-size:20rpx}.level-pips .level-on{color:#72d8cf}.zodiac-grid{margin-top:20rpx}.zodiac-grid label{width:calc(33.333% - 11rpx)}.lx-button.secondary{margin-top:26rpx;background:rgba(67,113,142,.34);border-color:rgba(114,216,207,.5);color:#d9faf4}
