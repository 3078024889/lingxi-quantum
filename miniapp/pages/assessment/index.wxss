.product-nav{position:relative;z-index:4;padding:calc(env(safe-area-inset-top) + 24rpx) 30rpx 20rpx;display:flex;align-items:center}.back,.nav-spacer{width:150rpx}.back{color:rgba(238,239,255,.7);font-size:26rpx}.back-arrow{font-size:46rpx;vertical-align:-4rpx;margin-right:10rpx}.nav-brand{flex:1;text-align:center;color:#d7c9a9;letter-spacing:8rpx}.assessment{padding-bottom:100rpx}.form,.preview{margin-top:40rpx;padding:38rpx 30rpx}.form-title{font-size:28rpx;color:#e9ddb9;letter-spacing:4rpx;margin-bottom:22rpx}.form-title.second{margin-top:42rpx}.field{box-sizing:border-box;width:100%;min-height:84rpx;margin-top:16rpx;padding:20rpx 22rpx;color:#f3f3ff;background:rgba(4,15,40,.28);border:1rpx solid rgba(255,255,255,.16);border-radius:4rpx;font-size:27rpx}.date-row{display:flex;gap:14rpx}.date-row .field{flex:1;min-width:0}.switch-row{display:flex;align-items:center;justify-content:space-between;padding:25rpx 4rpx;color:rgba(239,241,255,.72);font-size:25rpx}.relation-types{display:flex;justify-content:space-between;margin-top:24rpx;color:rgba(239,241,255,.72);font-size:24rpx}.focus{height:150rpx}.privacy,.boundary{margin-top:24rpx;color:rgba(235,239,255,.5);font-size:21rpx;line-height:1.7}.error{margin-top:24rpx;padding:20rpx;color:#ffd7d7;border-left:2rpx solid #c77d83;background:rgba(118,42,59,.18)}.preview-title{font-size:38rpx;line-height:1.45;margin:24rpx 0;color:#f2ead4}.preview-insight{font-size:28rpx;line-height:1.9;color:rgba(241,242,255,.82)}.trait-row{display:flex;gap:12rpx;margin-top:30rpx}.trait{flex:1;padding:18rpx 10rpx;display:flex;flex-direction:column;gap:9rpx;text-align:center;border-top:1rpx solid rgba(116,220,210,.45);font-size:21rpx;color:rgba(235,239,255,.68)}
