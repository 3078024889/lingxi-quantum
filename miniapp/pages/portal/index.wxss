.portal{padding:100rpx 36rpx 170rpx}.header{display:flex;align-items:center;gap:12rpx}.brand{flex:1;font-size:25rpx;font-weight:700}.small,.bell{margin:0;padding:0 12rpx;font-size:24rpx;line-height:64rpx;background:var(--lx-bg-elevated);color:var(--lx-text)}.bell{font-size:36rpx}.hero{padding:72rpx 0 36rpx}.eyebrow{font-size:20rpx;letter-spacing:5rpx;color:var(--lx-text-muted)}.headline{margin-top:20rpx;font-size:54rpx;font-weight:700;line-height:1.3}.intro{margin:24rpx 0 34rpx;font-size:28rpx;line-height:1.7;color:var(--lx-text-soft)}.primary{background:var(--lx-button);color:var(--lx-button-text);font-size:28rpx;border-radius:20rpx}.section{font-size:28rpx;font-weight:650;margin:28rpx 0}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.tile{width:100%;text-align:left;margin:0;border:1rpx solid var(--lx-line);border-radius:20rpx;font-size:26rpx;background:var(--lx-bg-elevated);color:var(--lx-text);line-height:110rpx}.tile text{float:right;color:var(--lx-text-muted)}.row{background:transparent;color:var(--lx-text);border-bottom:1rpx solid var(--lx-line);text-align:left;border-radius:0;font-size:27rpx;line-height:100rpx}.row:after{border:0}.footer{position:fixed;bottom:0;left:0;right:0;display:flex;padding:20rpx 16rpx calc(20rpx + env(safe-area-inset-bottom));background:var(--lx-bg-elevated);border-top:1rpx solid var(--lx-line)}.footer button{flex:1;margin:0;font-size:26rpx;background:transparent;color:var(--lx-text);border:0}.footer button:after{border:0}
