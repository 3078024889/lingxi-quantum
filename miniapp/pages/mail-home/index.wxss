.mail-home{box-sizing:border-box;min-height:100vh;padding:80px 32rpx 190rpx;background:#f5f8f5;color:#173a32}.mail-home button{padding:0;margin:0;color:inherit;line-height:normal;background:transparent;border-radius:0}.mail-home button:after{border:0}.topbar,.brand{display:flex;align-items:center}.topbar{gap:18rpx;margin-bottom:30rpx}.brand{flex:1;gap:16rpx}.brand-symbol{display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;border-radius:23rpx;background:#173a32;color:#fff;font-size:40rpx}.brand-name{font-size:30rpx;font-weight:700}.brand-caption{margin-top:5rpx;font-size:21rpx;color:#758b83}.icon-button{width:66rpx;height:66rpx;font-size:36rpx!important;border:1rpx solid #dce7df!important;border-radius:50%!important;display:flex;align-items:center;justify-content:center}.account-button{font-size:25rpx!important;padding:20rpx 12rpx!important}.hero{position:relative;overflow:hidden;border:1rpx solid #d3e8da;border-radius:36rpx;background:linear-gradient(135deg,#e9f6e9,#d9eee6);padding:34rpx}.hero-kicker{display:flex;align-items:center;gap:10rpx;font-size:21rpx;color:#4f7967}.live-dot{width:10rpx;height:10rpx;border-radius:50%;background:#439475}.hero-title{position:relative;z-index:1;margin-top:30rpx;font-size:60rpx;line-height:1.2;font-weight:750;letter-spacing:-2rpx}.hero-description{position:relative;z-index:1;margin-top:24rpx;font-size:24rpx;line-height:1.8;color:#587266;max-width:410rpx}.start-button{position:relative;z-index:2;margin-top:40rpx!important;border-radius:20rpx!important;background:#173a32!important;color:#fff!important;font-size:28rpx!important;line-height:88rpx!important;text-align:left;padding:0 26rpx!important}.start-button text{float:right;font-size:35rpx}.hero-footnote{margin-top:18rpx;text-align:center;font-size:19rpx;color:#688376}.envelope{position:absolute;right:-15rpx;top:112rpx;width:180rpx;height:170rpx;transform:rotate(-12deg);opacity:.65}.envelope-flap{position:absolute;top:15rpx;left:8rpx;width:148rpx;height:110rpx;transform:rotate(45deg);background:#a7ccbc;border-radius:15rpx}.letter{position:absolute;left:12rpx;top:10rpx;width:148rpx;height:130rpx;border-radius:12rpx;background:#f9fff8;padding:20rpx;box-sizing:border-box}.letter-line{height:6rpx;margin-top:14rpx;border-radius:5rpx;background:#c0d8c9}.letter-line.short{width:55%}.envelope-front{position:absolute;bottom:5rpx;left:0;width:170rpx;height:95rpx;background:linear-gradient(145deg,#bfdcc9,#9ccbb6);border-radius:8rpx 8rpx 20rpx 20rpx;text-align:center;line-height:95rpx;font-size:40rpx;color:#4c8167;box-shadow:0 14rpx 24rpx #9bbfab40}.envelope-badge{position:absolute;right:-8rpx;bottom:-6rpx;background:#fffaf0;border-radius:22rpx;padding:10rpx 16rpx;font-size:17rpx;letter-spacing:2rpx;color:#4c6a5a}.section-header{display:flex;align-items:center;justify-content:space-between;margin:44rpx 0 22rpx}.section-title{font-size:32rpx;font-weight:700}.section-caption{margin-top:10rpx;font-size:22rpx;color:#839389}.text-button{font-size:23rpx!important;color:#547665!important;padding:14rpx 0 14rpx 20rpx!important}.tool-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.tool-card{box-sizing:border-box;width:100%;text-align:left;padding:24rpx!important;border:1rpx solid #e2e9e1!important;border-radius:24rpx!important;background:#fffefa!important}.tool-icon{display:flex;align-items:center;justify-content:center;width:60rpx;height:60rpx;border-radius:18rpx;font-size:28rpx;font-weight:600}.mint{background:#e5f1e7;color:#47745d}.blue{background:#e6edf7;color:#50759e}.peach{background:#fbebdd;color:#ab784f}.purple{background:#ede7f4;color:#846e9b}.tool-title{margin-top:20rpx;font-size:27rpx;font-weight:650}.tool-detail{margin-top:10rpx;font-size:21rpx;line-height:1.5;color:#819085}.creative-card{display:flex;align-items:center;gap:20rpx;margin-top:26rpx!important;padding:30rpx 24rpx!important;background:#eae8f5!important;border:1rpx solid #dedaf0!important;border-radius:24rpx!important;text-align:left}.creative-icon{font-size:56rpx;color:#8a79b0}.creative-copy{flex:1}.creative-title{font-size:28rpx;font-weight:650;color:#4f496b}.creative-detail{margin-top:10rpx;font-size:21rpx;color:#87809e}.creative-arrow{font-size:36rpx;color:#8a79b0}.link-panel{background:#fffefa;border:1rpx solid #e2e9e1;border-radius:24rpx;padding:0 24rpx}.link-row{display:flex;align-items:center;justify-content:space-between;width:100%;text-align:left;padding:26rpx 0!important;border-bottom:1rpx solid #edf0e9!important}.link-title{font-size:27rpx;font-weight:650}.link-detail{margin-top:10rpx;font-size:22rpx;color:#819085}.link-row text{font-size:30rpx;color:#769583}.quick-links{display:flex;justify-content:space-between;gap:10rpx}.quick-links button{font-size:22rpx!important;padding:26rpx 0!important;color:#587564!important}.closing-note{text-align:center;margin:40rpx 0 12rpx;font-size:23rpx;color:#819085}.closing-note view{margin-top:15rpx;font-size:17rpx;letter-spacing:5rpx;color:#a0ada3}.bottom-nav{position:fixed;z-index:5;bottom:0;left:0;right:0;display:flex;background:#fffefa;border-top:1rpx solid #e2e9e1;padding:18rpx 16rpx calc(18rpx + env(safe-area-inset-bottom))}.bottom-nav button{flex:1;font-size:21rpx!important;color:#85958b!important}.bottom-nav text{display:block;font-size:35rpx;margin-bottom:8rpx}.bottom-nav .selected{color:#285c45!important;font-weight:650}
