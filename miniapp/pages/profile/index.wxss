.order { min-height: auto; margin-bottom: 18rpx; }
.arrow { color: #76ded2; margin-top: 16rpx; font-size: 23rpx; }
.benefit { margin-bottom: 14rpx; padding: 24rpx 28rpx; font-size: 26rpx; }
.benefit-date { color: #aeb3c9; margin-top: 8rpx; font-size: 22rpx; }
.archive-tools { display: flex; align-items: center; gap: 16rpx; margin: 18rpx 0 20rpx; padding: 14rpx 20rpx; }
.archive-tools input { flex: 1; color: #eef5ff; font-size: 26rpx; }
.clear-search { color: #76ded2; font-size: 24rpx; }
.manifest-entry { display: block; width: 100%; margin: 28rpx 0 20rpx; padding: 30rpx; border: 1rpx solid rgba(125, 224, 215, .52); border-radius: 8rpx; background: linear-gradient(125deg, rgba(90, 68, 162, .34), rgba(40, 139, 151, .22)); color: #eef8ff; text-align: left; box-shadow: 0 18rpx 50rpx rgba(4, 14, 45, .24); }
.manifest-entry::after { border: 0; }
.manifest-kicker { color: #7de0d7; font-size: 19rpx; letter-spacing: 4rpx; }
.manifest-title { margin-top: 12rpx; font-family: Georgia, serif; font-size: 36rpx; letter-spacing: 3rpx; }
.manifest-note { margin-top: 12rpx; color: #c5d1e5; font-size: 24rpx; line-height: 1.7; }
.manifest-action { margin-top: 22rpx; color: #8be8dc; font-size: 24rpx; }
.quick-links { display: flex; gap: 16rpx; margin-bottom: 30rpx; }
.quick-link { flex: 1; margin: 0; padding: 16rpx 10rpx; border: 1rpx solid rgba(125, 224, 215, .45); border-radius: 6rpx; background: rgba(85, 135, 173, .18); color: #dcecff; font-size: 24rpx; line-height: 1.4; }
.support-list { overflow: hidden; }
.support-link { display: flex; align-items: center; justify-content: space-between; min-height: 86rpx; padding: 0 26rpx; border-bottom: 1rpx solid rgba(154,181,218,.12); color: rgba(239,244,255,.88); font-size: 25rpx; }
.support-link:last-child { border-bottom: 0; }
.support-arrow { color: #76ded2; font-size: 28rpx; }
.support-contact { width: 100%; margin: 18rpx 0 0; border: 1rpx solid rgba(125,224,215,.4); border-radius: 6rpx; background: rgba(85,135,173,.16); color: #8be8dc; font-size: 24rpx; }
.support-contact::after { border: 0; }
.support-note { margin-top: 16rpx; color: rgba(224,231,248,.5); font-size: 21rpx; line-height: 1.7; }
