.order { min-height: auto; margin-bottom: 18rpx; }
.arrow { color: #76ded2; margin-top: 16rpx; font-size: 23rpx; }
.benefit { margin-bottom: 14rpx; padding: 24rpx 28rpx; font-size: 26rpx; }
.benefit-date { color: #aeb3c9; margin-top: 8rpx; font-size: 22rpx; }
.archive-tools { display: flex; align-items: center; gap: 16rpx; margin: 18rpx 0 20rpx; padding: 14rpx 20rpx; }
.archive-tools input { flex: 1; color: #eef5ff; font-size: 26rpx; }
.clear-search { color: #76ded2; font-size: 24rpx; }
.quick-links { display: flex; gap: 16rpx; margin-bottom: 30rpx; }
.quick-link { flex: 1; margin: 0; padding: 16rpx 10rpx; border: 1rpx solid rgba(125, 224, 215, .45); border-radius: 6rpx; background: rgba(85, 135, 173, .18); color: #dcecff; font-size: 24rpx; line-height: 1.4; }
