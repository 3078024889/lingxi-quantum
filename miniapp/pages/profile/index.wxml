<view class="lx-page">
  <view class="lx-shell">
    <view class="lx-brand">
      <view class="lx-brand-name">灵犀场</view>
      <view class="lx-brand-en">ACCOUNT</view>
    </view>

    <view class="lx-kicker">YOUR LINGXIFIELD</view>
    <view class="lx-title">我的</view>
    <view class="lx-subtitle">账户、订单、余额与正在进行的项目，都从这里继续。</view>

    <view class="lx-feature">
      <view class="lx-status">
        <view class="lx-status-dot {{connected ? 'ready' : ''}}"></view>
        <text wx:if="{{checking}}">正在确认微信身份…</text>
        <text wx:elif="{{connected}}">微信身份已连接</text>
        <text wx:else>微信身份暂未连接</text>
      </view>
      <button wx:if="{{!connected && !checking}}" class="lx-button secondary" bindtap="relogin">重新连接</button>
    </view>

    <view class="lx-section">
      <view class="lx-list">
        <view class="lx-row" data-path="/account" bindtap="openWeb">
          <view class="lx-row-main">
            <view class="lx-row-title">工作区与账户</view>
            <view class="lx-row-note">继续查看项目、账户信息与使用记录。</view>
          </view>
          <view class="lx-arrow">›</view>
        </view>
        <view class="lx-row" data-path="/account/orders" bindtap="openWeb">
          <view class="lx-row-main">
            <view class="lx-row-title">订单与记录</view>
            <view class="lx-row-note">查看支付、服务交付与历史使用记录。</view>
          </view>
          <view class="lx-arrow">›</view>
        </view>
        <view class="lx-row" data-path="/ai-wallet" bindtap="openWeb">
          <view class="lx-row-main">
            <view class="lx-row-title">AI 余额与额度</view>
            <view class="lx-row-note">查看余额、额度与 AI 使用情况。</view>
          </view>
          <view class="lx-arrow">›</view>
        </view>
      </view>
    </view>

    <view class="lx-feature">
      <view class="lx-feature-title">已有网页灵犀场账户？</view>
      <view class="lx-feature-note">由你主动确认后再连接，不自动猜测、合并或迁移身份。</view>
      <button class="lx-button" loading="{{linking}}" bindtap="connectExistingAccount">连接已有账户</button>
    </view>

    <view class="lx-section">
      <view class="lx-list">
        <view class="lx-row" data-path="/privacy" bindtap="openWeb"><view class="lx-row-main"><view class="lx-row-title">隐私政策</view></view><view class="lx-arrow">›</view></view>
        <view class="lx-row" data-path="/terms" bindtap="openWeb"><view class="lx-row-main"><view class="lx-row-title">服务条款</view></view><view class="lx-arrow">›</view></view>
        <view class="lx-row" data-path="/refunds" bindtap="openWeb"><view class="lx-row-main"><view class="lx-row-title">退款政策</view></view><view class="lx-arrow">›</view></view>
      </view>
    </view>

    <button class="lx-button secondary" open-type="contact">联系微信客服</button>
    <view class="lx-support">支付、账户连接或内容交付遇到问题，可直接联系微信客服。</view>
  </view>
</view>
