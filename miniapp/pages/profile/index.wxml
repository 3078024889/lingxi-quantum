<view class="lx-page">
  <field-nav/>
  <view class="lx-content">
    <view class="lx-kicker">MY FIELD</view>
    <view class="lx-title">我的场域</view>
    <view class="lx-subtitle">你的探索记录，都将在这里延续。<br/>每一次观测、觉察与变化，<br/>都将沉淀为专属于你的生命档案。</view>

    <view wx:if="{{loading}}" class="lx-loading">正在同步权益…</view>
    <block wx:else>
      <view wx:if="{{archetype}}" class="archetype-progress lx-veil">
        <view class="lx-kicker">FIELD 09 · CONVERGENCE</view>
        <view class="lx-card-title">生命原型 · 八域汇流</view>
        <view wx:if="{{archetype.ready}}" class="lx-card-note">八个支流已在一年有效期内全部激活，生命原型已自动生成并保存到下方生命档案。</view>
        <view wx:else class="lx-card-note">已激活 {{archetype.completed}} / 8 个基础场域。全部完成并开启后，生命原型将自动生成，不需另行购买。</view>
      </view>
      <button class="manifest-entry lx-veil" bindtap="manifestation">
        <view class="manifest-kicker">CORE FIELD · 意识显化</view>
        <view class="manifest-title">进入意识显化</view>
        <view class="manifest-note">让观测成为创造，让内在选择进入现实。</view>
        <view class="manifest-action">进入核心场域 →</view>
      </button>

      <view class="archive-tools lx-veil">
        <input value="{{query}}" placeholder="搜索已购报告、叙事或修炼" bindinput="onSearch"/>
        <view wx:if="{{query}}" class="clear-search" bindtap="clearSearch">清除</view>
      </view>

      <view class="quick-links">
        <button class="quick-link" bindtap="explore">探索场域精测</button>
        <button class="quick-link" bindtap="narratives">浏览多维叙事</button>
        <button class="quick-link" bindtap="website">进入灵犀场官网</button>
      </view>

      <view class="lx-section">
        <view class="lx-section-title">生命档案与已开启内容</view>
        <view wx:if="{{!filteredOrders.length}}" class="lx-empty lx-veil">尚未找到已购内容。<br/>可前往场域精测或多维叙事继续探索。</view>
        <view wx:for="{{filteredOrders}}" wx:key="id" class="lx-card lx-veil order" data-order="{{item}}" bindtap="openOrder">
          <view class="lx-card-title">{{item.submission_name || item.productName}}</view>
          <view class="lx-card-note">{{item.webOnly ? '网页历史档案' : '权益已开启'}} · {{item.paidLabel}}</view>
          <view class="arrow">{{opening === item.id ? '正在安全打开…' : item.webOnly ? '前往网页档案 →' : item.submission_id ? '打开完整档案 →' : '继续阅读 / 进入 →'}}</view>
        </view>
      </view>

      <view class="lx-section">
        <view class="lx-section-title">长期与订阅权益</view>
        <view wx:if="{{!filteredUnlocks.length}}" class="lx-card lx-veil"><view class="lx-card-note">目前没有单独的订阅权益。</view></view>
        <view wx:for="{{filteredUnlocks}}" wx:key="product_id" class="benefit lx-veil" data-unlock="{{item}}" bindtap="openUnlock">
          <view>{{item.productName || item.product_id}}</view>
          <view class="benefit-date">{{opening === item.product_id ? '正在安全打开…' : item.webOnly ? item.expiryLabel + ' · 前往网页档案 →' : item.expiryLabel + ' · 打开 →'}}</view>
        </view>
      </view>

      <view class="lx-section">
        <view class="lx-section-title">账号连接</view>
        <view class="lx-card lx-veil">
          <view class="lx-card-note">已有网页灵犀账户或已购报告？登录后确认连接，即可迁入既有权益与报告；系统不会自动猜测或合并身份。</view>
          <button class="lx-button compact" bindtap="connectExistingAccount">连接已有灵犀账户</button>
        </view>
      </view>

      <view class="lx-section">
        <view class="lx-section-title">规则与支持</view>
        <view class="support-list lx-veil">
          <view class="support-link" data-path="/terms" bindtap="openPolicy"><text>服务条款</text><text class="support-arrow">›</text></view>
          <view class="support-link" data-path="/refunds" bindtap="openPolicy"><text>退款政策</text><text class="support-arrow">›</text></view>
          <view class="support-link" data-path="/privacy" bindtap="openPolicy"><text>隐私政策</text><text class="support-arrow">›</text></view>
          <view class="support-link" data-path="/declaration" bindtap="openPolicy"><text>系统声明</text><text class="support-arrow">›</text></view>
          <view class="support-link" data-path="/about" bindtap="openPolicy"><text>关于灵犀场</text><text class="support-arrow">›</text></view>
        </view>
        <button class="support-contact" open-type="contact">联系微信客服</button>
        <view class="support-note">支付、权益同步或内容交付遇到问题，可直接联系微信客服。规则内容与灵犀场官网保持一致。</view>
      </view>
    </block>
  </view>
</view>
