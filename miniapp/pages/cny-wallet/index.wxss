page{background:#f4f7fc;color:#1c2b43;min-height:100%}
.cny-wallet-page{box-sizing:border-box;min-height:100vh;padding:0 30rpx 56rpx;background:radial-gradient(circle at 92% 3%,rgba(199,218,255,.52),transparent 34%),linear-gradient(180deg,#f8faff 0%,#f1f5fb 100%)}
.cny-wallet-nav{height:88rpx;display:flex;align-items:center;justify-content:space-between}
.cny-back{width:140rpx;color:#52709c;font-size:26rpx}
.cny-nav-title{font-size:29rpx;font-weight:700;color:#233957}
.cny-nav-spacer{width:140rpx}
.cny-balance-value{margin-top:10rpx;font-size:56rpx;font-weight:800;letter-spacing:1rpx;color:#234b83}
.cny-account-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid #e3eaf4}
.cny-account-copy{display:flex;flex:1;min-width:0;flex-direction:column;gap:7rpx}
.cny-account-caption{font-size:19rpx;color:#8797ae}
.cny-account-name{font-size:22rpx;font-weight:650;color:#344b6a;overflow-wrap:anywhere}
.cny-account-button{flex-shrink:0;margin:0;padding:0 22rpx;height:64rpx;line-height:64rpx;border:1rpx solid #cbd8eb;border-radius:14rpx;background:#fff;color:#3768a9;font-size:21rpx}
.cny-section-card{margin-top:24rpx;padding:28rpx;border:1rpx solid #e1e8f2;border-radius:26rpx;background:rgba(255,255,255,.96);box-shadow:0 12rpx 32rpx rgba(55,83,126,.05)}
.cny-section-title{font-size:31rpx;font-weight:800;color:#243b5b}
.cny-account-button::after,.cny-primary-button::after,.cny-secondary-button::after{border:0}
.cny-status-card{display:flex;gap:13rpx;align-items:flex-start;margin-top:22rpx;padding:22rpx 23rpx;border:1rpx solid #dfe8f5;border-radius:18rpx;background:rgba(255,255,255,.82)}
.cny-status-indicator{flex-shrink:0;width:13rpx;height:13rpx;margin-top:8rpx;border-radius:50%;background:#6f9bd2;box-shadow:0 0 0 6rpx rgba(111,155,210,.12)}
.cny-status-message{font-size:22rpx;line-height:1.7;color:#60748f}
.cny-primary-button{width:100%;height:94rpx;margin-top:24rpx;border-radius:19rpx;background:linear-gradient(105deg,#3978c5,#5b91d6);color:#fff;font-size:29rpx;font-weight:800;line-height:94rpx;box-shadow:0 12rpx 26rpx rgba(58,112,185,.2)}
.cny-primary-button[disabled]{background:#cbd5e3;color:#fff;box-shadow:none}
.cny-pending-note{margin-top:13rpx;text-align:center;font-size:20rpx;line-height:1.6;color:#9a7650}
.cny-secondary-button{width:100%;height:78rpx;margin-top:14rpx;border:1rpx solid #d4dfef;border-radius:16rpx;background:#fff;color:#55749e;font-size:23rpx;line-height:78rpx}
.cny-security-note{margin:22rpx 5rpx 0;text-align:center;font-size:18rpx;line-height:1.8;color:#98a5b6}
