<view class="cny-wallet-page">
  <view class="cny-wallet-nav">
    <text class="cny-back" bindtap="back">‹ 返回</text>
    <text class="cny-nav-title">微信支付</text>
    <text class="cny-nav-spacer"></text>
  </view>

  <view class="cny-section-card">
    <view class="cny-section-title">确认微信支付</view>
    <view class="cny-balance-value">¥{{amountText}}</view>
    <view class="cny-account-row">
      <view class="cny-account-copy">
        <text class="cny-account-caption">到账账户</text>
        <text class="cny-account-name">{{accountLabel || '等待连接官网账户'}}</text>
      </view>
      <button class="cny-account-button" bindtap="connectAccount" disabled="{{busy}}">{{linked ? '切换账户' : '连接账户'}}</button>
    </view>
  </view>

  <view class="cny-status-card">
    <view class="cny-status-indicator"></view>
    <view class="cny-status-message">{{message}}</view>
  </view>

  <button wx:if="{{!orderId && !requestId}}" class="cny-primary-button"
    bindtap="pay" loading="{{busy}}" disabled="{{busy || loading || !enabled || !linked}}">
    {{busy ? '正在准备支付…' : '确认金额并充值 ¥' + amountText}}
  </button>
  <button wx:elif="{{requestId && !orderId}}" class="cny-primary-button"
    bindtap="recoverPending" loading="{{busy}}" disabled="{{busy || loading || !enabled || !linked}}">
    恢复上次充值
  </button>
  <button wx:elif="{{orderId && canResumePayment}}" class="cny-primary-button"
    bindtap="pay" loading="{{busy}}" disabled="{{busy}}">
    继续完成上一笔支付
  </button>
  <button wx:elif="{{orderId}}" class="cny-primary-button"
    bindtap="confirmPayment" loading="{{busy}}" disabled="{{busy}}">
    核验上一笔支付结果
  </button>
  <view wx:if="{{orderId || requestId}}" class="cny-pending-note">
    上一笔订单尚未完成核验。核验关闭前不会创建第二笔充值。
  </view>
  <button wx:if="{{!enabled}}" class="cny-secondary-button" bindtap="refreshAvailability" loading="{{loading}}" disabled="{{loading}}">
    重新检查充值服务
  </button>
  <button wx:if="{{!accountLoaded && !loading}}" class="cny-secondary-button" bindtap="refreshAccount" disabled="{{busy}}">
    重新读取账户
  </button>

  <view class="cny-security-note">支付按钮返回不代表余额已到账。灵犀场会向微信核验订单，并以服务端账本入账结果为准。</view>
</view>
