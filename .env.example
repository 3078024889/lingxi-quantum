# 部署这份代码需要在 Vercel 项目设置（或 .env.local，本地开发用）里配置以下变量。
# 真实密钥不要提交进代码仓库。

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://lingxifield.com

SASI_BILLING_ENABLED=false
SASI_JOBS_ENABLED=false
SASI_CONTENT_LABELING_ENABLED=false
SASI_CONTENT_LABELING_MODE=sasi_aigc_v1
SASI_CONTENT_PRODUCER_CODE=LINGXIFIELD
SASI_BYOK_ENCRYPTION_KEY=
SASI_REFUND_FLOW_TESTED=false
SASI_RMB_BALANCE_V1_ENABLED=false
SASI_QUOTE_SECRET=
CRON_SECRET=

ARK_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=

PAYPAL_ENABLED=false
# USD 钱包充值在真正 USD 消费结算闭环完成前保持关闭；不影响其它 PayPal 直接支付能力。
USD_BALANCE_TOPUP_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live
PAYPAL_WEBHOOK_ID=

ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_SITE_URL=https://lingxifield.cn
ALIPAY_ENABLED=false

WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_PLATFORM_PUBLIC_KEY_ID=
WECHAT_APP_SECRET=

NEXT_PUBLIC_REVIEW_MODE=false

# ─────────────────────────────────────────────────────────────────────────────
# SASI daily experience pool (server-side only; never NEXT_PUBLIC_*)
# Each source is opt-in. Keep disabled until the provider's current terms,
# quota and public-SaaS use have been reviewed for your account.
# The UI never exposes provider/model names.
# ─────────────────────────────────────────────────────────────────────────────
SASI_EXPERIENCE_DAILY_SECONDS_EQUIVALENT=180
SASI_EXPERIENCE_REGION_MODE=auto

# Global pool
SASI_EXPERIENCE_OPENROUTER_ENABLED=false
SASI_EXPERIENCE_OPENROUTER_API_KEY=
SASI_EXPERIENCE_OPENROUTER_MODEL=openrouter/free
SASI_EXPERIENCE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SASI_EXPERIENCE_OPENROUTER_PRIORITY=10

SASI_EXPERIENCE_GROQ_ENABLED=false
SASI_EXPERIENCE_GROQ_API_KEY=
SASI_EXPERIENCE_GROQ_MODEL=
SASI_EXPERIENCE_GROQ_BASE_URL=https://api.groq.com/openai/v1
SASI_EXPERIENCE_GROQ_PRIORITY=20

SASI_EXPERIENCE_CEREBRAS_ENABLED=false
SASI_EXPERIENCE_CEREBRAS_API_KEY=
SASI_EXPERIENCE_CEREBRAS_MODEL=
SASI_EXPERIENCE_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
SASI_EXPERIENCE_CEREBRAS_PRIORITY=30

SASI_EXPERIENCE_NVIDIA_ENABLED=false
SASI_EXPERIENCE_NVIDIA_API_KEY=
SASI_EXPERIENCE_NVIDIA_MODEL=
SASI_EXPERIENCE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
SASI_EXPERIENCE_NVIDIA_PRIORITY=40

SASI_EXPERIENCE_GEMINI_ENABLED=false
SASI_EXPERIENCE_GEMINI_API_KEY=
SASI_EXPERIENCE_GEMINI_MODEL=
SASI_EXPERIENCE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
SASI_EXPERIENCE_GEMINI_PRIORITY=50

SASI_EXPERIENCE_CLOUDFLARE_ENABLED=false
SASI_EXPERIENCE_CLOUDFLARE_ACCOUNT_ID=
SASI_EXPERIENCE_CLOUDFLARE_API_TOKEN=
SASI_EXPERIENCE_CLOUDFLARE_MODEL=
SASI_EXPERIENCE_CLOUDFLARE_PRIORITY=60

# China pool
SASI_EXPERIENCE_ZHIPU_ENABLED=false
SASI_EXPERIENCE_ZHIPU_API_KEY=
SASI_EXPERIENCE_ZHIPU_MODEL=
SASI_EXPERIENCE_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
SASI_EXPERIENCE_ZHIPU_PRIORITY=10

SASI_EXPERIENCE_VOLCENGINE_ENABLED=false
SASI_EXPERIENCE_VOLCENGINE_API_KEY=
SASI_EXPERIENCE_VOLCENGINE_MODEL=
SASI_EXPERIENCE_VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SASI_EXPERIENCE_VOLCENGINE_PRIORITY=20

SASI_EXPERIENCE_ALIYUN_ENABLED=false
SASI_EXPERIENCE_ALIYUN_API_KEY=
SASI_EXPERIENCE_ALIYUN_MODEL=
SASI_EXPERIENCE_ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SASI_EXPERIENCE_ALIYUN_PRIORITY=30


# R9 smart balancing. These are relative weights, not promises of provider quota.
# Increase DAILY_SHARE for providers/accounts with more reliable free capacity.
SASI_EXPERIENCE_OPENROUTER_DAILY_SHARE=1
SASI_EXPERIENCE_GROQ_DAILY_SHARE=1
SASI_EXPERIENCE_CEREBRAS_DAILY_SHARE=1
SASI_EXPERIENCE_NVIDIA_DAILY_SHARE=1
SASI_EXPERIENCE_GEMINI_DAILY_SHARE=1
SASI_EXPERIENCE_CLOUDFLARE_DAILY_SHARE=1
SASI_EXPERIENCE_MISTRAL_DAILY_SHARE=1
SASI_EXPERIENCE_ZHIPU_DAILY_SHARE=1
SASI_EXPERIENCE_VOLCENGINE_DAILY_SHARE=1
SASI_EXPERIENCE_ALIYUN_DAILY_SHARE=1


# R10 continuity / canary
# 100 = all enabled experience providers participate. Lower only for newly introduced providers.
SASI_EXPERIENCE_CANARY_PERCENT=100


# SASI detached worker (server-side only)
SASI_WORKER_SECRET=
SASI_WORKER_BUILD=
