# 部署这份代码需要在 Vercel 项目设置（或 .env.local，本地开发用）里配置以下变量。
# 这个文件本身不含真实密钥，只是清单——真实值不要提交进代码仓库。

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 站点 ──
NEXT_PUBLIC_SITE_URL=https://lingxifield.com

# ── SASI 制作内核 ──
# 三个开关均通过真实验收后才设为 true。任一关闭，SASI 都不会接受制作账户入账或付费任务。
SASI_BILLING_ENABLED=false
SASI_JOBS_ENABLED=false
SASI_CONTENT_LABELING_ENABLED=false
# SASI 自行写入 GB 45438-2025 附录 E 结构的 AIGC 文件元数据；画面不叠加持续水印。
SASI_CONTENT_LABELING_MODE=sasi_aigc_v1
SASI_CONTENT_PRODUCER_CODE=LINGXIFIELD
# 视频供应路由。密钥只放服务端；模型 ID 必须来自已在对应账户中真实验证过的正式模型。
# 火山方舟当前主质量线路。SASI_SEEDANCE_VIDEO_MODEL 填控制台实际开放的模型或推理接入点 ID；不要凭空填写版本号。
ARK_API_KEY=
SASI_SEEDANCE_VIDEO_MODEL=
XAI_API_KEY=
SASI_XAI_VIDEO_MODEL=grok-imagine-video-1.5
OPENAI_API_KEY=
SASI_OPENAI_VIDEO_MODEL=sora-2
SASI_OPENAI_CINEMA_MODEL=sora-2-pro
DASHSCOPE_API_KEY=
SASI_WAN_VIDEO_MODEL=wan2.7-t2v
# 必须使用百炼业务空间的 /api/v1 根地址，例如：
# https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api/v1
SASI_WAN_BASE_URL=
# 只有完成真实付费任务、查询、下载、内容标识与账单核对的供应商才可写入，逗号分隔：seedance,xai,openai,wan
SASI_VERIFIED_VIDEO_PROVIDERS=
# 供应结果若跳转到内置规则之外的 HTTPS 媒体域名，逐个列出精确域名，逗号分隔；不要使用通配符。
SASI_PROVIDER_ASSET_HOSTS=
# BYOK 凭证保险箱主密钥：openssl rand -base64 32。只允许配置在服务端；更换前必须先实施密钥轮换。
SASI_BYOK_ENCRYPTION_KEY=
# 完成重复回调、供应失败、取消/不可取消分支和额度返还验收后才设为 true。
SASI_REFUND_FLOW_TESTED=false
# 至少 24 位随机值，用于保护 /api/internal/sasi/reconcile。
CRON_SECRET=

# ── AI 生成（智谱）──
ZHIPU_API_KEY=
ZHIPU_MODEL=
ZHIPU_KNOWLEDGE_ID=

# ── PayPal（v144 起替换了原来的 NOWPayments 加密货币网关）──
# 去 PayPal 开发者后台 https://developer.paypal.com/dashboard/applications 创建一个 App，拿到：
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "live" = 正式收款；"sandbox" = 用 PayPal 沙盒测试账号跑通整条流程，不涉及真实资金。
# 建议先用 sandbox 完整测试一遍"下单→付款→自动解锁"，确认没问题再切 live。
PAYPAL_ENV=live
# 在 PayPal 开发者后台给这个 App 订阅 Webhook（事件至少勾选 PAYMENT.CAPTURE.COMPLETED），
# Webhook 地址填 https://lingxifield.com/api/pay/webhook，订阅成功后会给一个 Webhook ID，填在这里。
# 这个是"用户付完款没有正常跳转回网站"时的兜底保障，强烈建议配置，不要跳过。
PAYPAL_WEBHOOK_ID=

# ── 支付宝网页支付（电脑网站支付 + 手机网站支付）──
# 在 open.alipay.com 创建网页/移动应用，开通对应支付产品并完成上线后配置。
ALIPAY_APP_ID=
# 应用私钥，只留在服务端；支持完整 PEM 或去掉头尾后的 Base64 内容。
ALIPAY_PRIVATE_KEY=
# 注意：这里填写“支付宝公钥”，不是应用公钥；用于验签异步通知。
ALIPAY_PUBLIC_KEY=
# 可选但建议配置，用于通知中额外核对收款方身份。
ALIPAY_SELLER_ID=
# 正式网关默认如下；沙箱联调时显式改为沙箱网关，勿用代码开关混淆环境。
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 支付宝独立使用已备案的 .cn 域名生成 notify_url / return_url。
ALIPAY_SITE_URL=https://lingxifield.cn
# 只有网页应用、电脑网站支付、手机网站支付全部审核通过并完成实付验收后才改 true。
ALIPAY_ENABLED=false

# ── 微信支付（.cn 站点用，v240 起接入，v262 补充 JSAPI）──
# 都在 pay.weixin.qq.com 商户平台「账户中心 → API安全」这一页申请/下载：
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY=
WECHAT_CERT_SERIAL_NO=
# 用来验证微信支付服务器推送过来的通知真的是官方发的（不是伪造的），
# 在商户平台「账户中心 → API安全 → 微信支付公钥」下载：
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_PLATFORM_PUBLIC_KEY_ID=
# v262新增——JSAPI支付专用，跟支付相关的密钥是两码事：这是公众号本身
# 的 AppSecret，在 mp.weixin.qq.com 公众号后台「设置与开发 → 基本配置」
# 这一页。同时必须在同一后台「设置与开发 → 公众号设置 → 功能设置 →
# 网页授权域名」把 lingxifield.cn 加进去（会要求下载一个校验文件放到
# 网站根目录），少了这一步，JSAPI在微信内浏览器里会直接报
# "redirect_uri参数错误"，跟pay.weixin.qq.com那边的"JSAPI支付授权目录"
# 是两个完全独立的配置，两个都要配。
WECHAT_APP_SECRET=

# —— 微信小程序（与服务号为两个 AppID/AppSecret，禁止混用）——
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
# openssl rand -base64 32；仅用于服务端加密保存微信 session_key。
WECHAT_MINI_SESSION_ENCRYPTION_KEY=

# —— 小程序虚拟支付 · 道具直购 ——
WECHAT_MINI_VPAY_OFFER_ID=
WECHAT_MINI_VPAY_APP_KEY=
WECHAT_MINI_VPAY_SANDBOX_APP_KEY=
# sandbox | production；正式发布前必须切换为 production。
WECHAT_MINI_VPAY_ENV=sandbox

# 小程序后台「开发管理 → 消息推送」自定义 Token。
# 回调 URL: https://lingxifield.cn/api/wechat/mini/pay/notify
# 当前代码要求选择明文 JSON 模式；切勿在未实现 AES 解密前选择安全模式。
WECHAT_MINI_MESSAGE_TOKEN=

# Development-only paid-content review. Production builds always ignore it.
NEXT_PUBLIC_REVIEW_MODE=false
