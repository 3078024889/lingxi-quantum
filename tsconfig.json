{
    "compilerOptions":  {
                            "target":  "ES2017",
                            "lib":  [
                                        "dom",
                                        "dom.iterable",
                                        "esnext"
                                    ],
                            "allowJs":  true,
                            "skipLibCheck":  true,
                            "strict":  true,
                            "noEmit":  true,
                            "esModuleInterop":  true,
                            "module":  "esnext",
                            "moduleResolution":  "bundler",
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "jsx":  "preserve",
                            "incremental":  true,
                            "plugins":  [
                                            {
                                                "name":  "next"
                                            }
                                        ],
                            "paths":  {
                                          "@/*":  [
                                                      "./*"
                                                  ]
                                      }
                        },
    "include":  [
                    "next-env.d.ts",
                    "**/*.ts",
                    "**/*.tsx",
                    ".next/types/**/*.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "_local",
                    "imports",
                    "skills/devoured-2026-09-18",
                    "skills/skills-devour-2026-09-18",
                    "tmp",
                    ".next",
                    "lingxifield-ai-market",
                    "lingxifield-ai-market/**",
                    "lingxifield-ai-market-*-backup*",
                    "lingxifield-ai-market-*-backup*/**",
                    "LINGXIFIELD_AI_MARKET_*",
                    "LINGXIFIELD_AI_MARKET_*/**",
                    "LINGXIFIELD_V2_*",
                    "LINGXIFIELD_V2_*/**",
                    "LINGXIFIELD_ADMIN_REVIEW_*",
                    "LINGXIFIELD_ADMIN_REVIEW_*/**",
                    ".ai_market_preview_backup_*",
                    ".ai_market_preview_backup_*/**",
                    "lingxifield-ai-market-backup-*",
                    "lingxifield-ai-market-backup-*/**",
                    "lingxifield-ai-market-v*-backup-*",
                    "lingxifield-ai-market-v*-backup-*/**"
                ]
}