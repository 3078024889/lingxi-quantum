{
  "openapi": "3.1.0",
  "info": {
    "title": "LINGXIFIELD Global SIAI and Free Local Tools",
    "version": "1.1.0",
    "summary": "Official-source-reviewed SI/AI directory and anonymous local tools",
    "description": "Read-only public distribution of approved SI/AI platform records and anonymous browser-local utilities. Research-only candidates and paid or server-metered tools are excluded."
  },
  "servers": [
    {
      "url": "https://lingxifield.com"
    }
  ],
  "paths": {
    "/api/public/siai-widget": {
      "get": {
        "operationId": "listReviewedSiaiPlatforms",
        "summary": "Read the approved SIAI directory",
        "description": "This public feed follows approved catalog updates after production publication. Entries may have null facts when no official source is available.",
        "responses": {
          "200": {
            "description": "Reviewed platforms",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Directory"
                }
              }
            }
          },
          "500": {
            "description": "Temporary catalog unavailable"
          }
        }
      }
    },
    "/siai/updates.xml": {
      "get": {
        "operationId": "getReviewedSiaiUpdates",
        "summary": "Subscribe to SIAI profile review timestamps",
        "description": "Review activity is not a declaration that a platform has launched a new product.",
        "responses": {
          "200": {
            "description": "RSS 2.0 document",
            "content": {
              "application/rss+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/free-tools-widget": {
      "get": {
        "operationId": "listAnonymousFreeLocalTools",
        "summary": "Read the anonymous free local-tools directory",
        "description": "Returns only tools marked local-only and excluded from the public paid-tool catalogue. No account, API key or visitor data is required.",
        "responses": {
          "200": {
            "description": "Anonymous local tools",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FreeToolsDirectory"
                }
              }
            }
          },
          "500": {
            "description": "Temporary directory unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Directory": {
        "type": "object",
        "required": [
          "schemaVersion",
          "publisher",
          "title",
          "site",
          "total",
          "rows"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "publisher": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "site": {
            "type": "string",
            "format": "uri"
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Platform"
            }
          }
        }
      },
      "Platform": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "website",
          "reviewedAt",
          "free",
          "price",
          "region",
          "payment"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "website": {
            "oneOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewedAt": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "free": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "price": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "region": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "payment": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "FreeToolsDirectory": {
        "type": "object",
        "required": [
          "schemaVersion",
          "publisher",
          "title",
          "site",
          "total",
          "rows"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "publisher": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "site": {
            "type": "string",
            "format": "uri"
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FreeLocalTool"
            }
          }
        }
      },
      "FreeLocalTool": {
        "type": "object",
        "required": [
          "slug",
          "titleZh",
          "titleEn",
          "descZh",
          "descEn",
          "href",
          "category",
          "kind",
          "access",
          "execution"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,80}$"
          },
          "titleZh": {
            "type": "string"
          },
          "titleEn": {
            "type": "string"
          },
          "descZh": {
            "type": "string"
          },
          "descEn": {
            "type": "string"
          },
          "href": {
            "type": "string",
            "pattern": "^/tools/[a-z0-9-]{1,80}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "pdf",
              "image",
              "media",
              "subtitle",
              "table",
              "privacy",
              "recognition",
              "text",
              "file",
              "other"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "document",
              "video",
              "audio",
              "privacy",
              "utility",
              "ai",
              "qr"
            ]
          },
          "access": {
            "type": "string",
            "const": "anonymous"
          },
          "execution": {
            "type": "string",
            "const": "local"
          }
        }
      }
    }
  }
}
